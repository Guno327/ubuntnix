#!/usr/bin/env bash
# bin/ubx-scan-deb-ownership — list every entry in a .deb's data.tar that
# is not root:root-owned, OR carries a setuid/setgid/sticky bit, OR whose
# real permission bits are more restrictive than the mode Nix's store-path
# canonicalization would leave it with (SPEC.md §4.1/§4.2; GitHub issue #10
# PR #36 follow-up: the "Bootable disk image + QEMU e2e" CI job failing to
# compose the full 168-package locked closure; GitHub issue #45: store-path
# canonicalization silently loosening a secrets-adjacent file's real mode).
#
# -- The problem this exists to work around ----------------------------
#
# nix/compose.nix's composeRootfs runs `dpkg --unpack`/`--configure`
# inside `unshare --user --map-root-user --mount --pid` (see that file's
# own HARDENING section): a SINGLE-id user-namespace mapping -- only the
# build uid/gid is mapped, to namespace-uid/gid 0. Per user_namespaces(7),
# chown(2)/lchown(2)/fchownat(2) to ANY id absent from that mapping fails
# with EINVAL, unconditionally, regardless of the calling process's
# capabilities -- the kernel simply has nothing to translate the target id
# through. dpkg's own extraction code (tarobject() in its archives.c)
# always attempts to chown every extracted file to the archive's own
# recorded owner (confirmed against dpkg upstream: see
# https://lists.debian.org/debian-dpkg/2007/12/msg00031.html, Ian
# Jackson's reply -- "dpkg will insist on setting the ownership of the
# files on-disk to that specified in the package", no force flag or
# DPKG_FORCE/env hook overrides this). The first package in this
# project's full locked closure whose data.tar embeds a non-root owner
# (libpam-modules-bin's setgid-shadow `pam_extrausers_chkpwd`) therefore
# hard-fails `dpkg --unpack` and aborts the whole compose.
#
# The genuinely general fix is fakeroot (LD_PRELOAD syscall interception,
# faking chown success while recording the intended owner) -- not yet in
# this project's locked archive set (see archive.packages.json's own
# "fakeroot" entry and its comment for why this script exists as an
# interim rather than waiting on that). This script implements the M1
# INTERIM instead: nix/compose.nix's composeRootfs calls it, per package,
# BEFORE that package's `dpkg --unpack`, to discover every path dpkg would
# fail on. The caller then (a) tells dpkg to skip extracting exactly those
# paths (`--path-exclude`, a real, long-supported dpkg mechanism -- unlike
# ownership, dpkg's PATH FILTERING happens before any chown attempt, so an
# excluded path never reaches the failing syscall at all), (b) places that
# path's real CONTENT+MODE itself afterward via a plain, unprivileged
# `tar -x --no-same-owner` of just that one archive member (chmod, unlike
# chown, needs no id-mapping -- it never references an external id at
# all), and (c) records the TRUE intended owner in a manifest applied at
# IMAGE-PACK time via mksquashfs's `-pf`/"m" (modify) pseudo-file
# mechanism -- which writes final squashfs inode metadata directly, with
# no chown(2) syscall involved, so it is not subject to this sandbox's
# id-mapping limit at all. See nix/compose.nix's own comments at the call
# site for the exact sequencing.
#
# -- The MODE follow-up (CI run 29955725327) -----------------------------
#
# The same "single-id-mapped user namespace, one layer down" family hits a
# SECOND, independent dpkg operation once the closure grows past the
# ownership-only packages above: dpkg's own unpack of `mount` --
#
#   rootfs-boot-proof> dpkg: error processing archive
#   /.ubx-compose/debs/142.deb (--unpack):
#   rootfs-boot-proof>  error setting permissions of './usr/bin/mount':
#   Operation not permitted
#
# -- fails EPERM chmod()-ing /usr/bin/mount (a perfectly ordinary
# root:root file) to its real mode, 4755: dpkg's tarobject() sets the
# extracted file's permission bits (fchmod) unconditionally too, exactly
# as it unconditionally chowns (see the citation above) -- and setting the
# setuid/setgid/sticky bit specifically is the one chmod(2) this build
# sandbox also cannot reliably perform, independent of whether the OWNER
# is root or not (this is NOT a downgrade-specific quirk of that one log
# line -- a first-time install of the same package would hit the identical
# chmod). So this script's scan trigger is now TWO-FOLD, not one: a member
# is selected for the exclude+restore+pseudo-file treatment if EITHER its
# recorded owner is not root:root (the original trigger, above) OR its
# recorded mode carries a setuid/setgid/sticky bit -- regardless of owner.
# Either way the caller's handling is identical: path-exclude it from
# dpkg's own extraction, restore its real CONTENT afterward with a plain
# SAFE mode (the same permission bits, with the set*id/sticky digit
# forced to 0 -- restoring that bit needs no id-mapping at all, only
# setting the SPECIAL bits does), and record its TRUE mode (special bits
# included) in the same mksquashfs pseudo-file manifest this script
# already emits for ownership -- see this file's "Output format" section
# below; no format change was needed, since a "modify" pseudo-file line
# already carries mode, uid, AND gid together. mksquashfs applies the real
# 4755 directly to the packed image's inode metadata, again with no
# chmod(2) syscall of any kind, so the sandbox restriction never applies
# to that final step either.
#
# -- The CANONICALIZATION follow-up (GitHub issue #45) --------------------
#
# The first two triggers above exist because dpkg's OWN unpack-time chown/
# chmod fails inside this build sandbox. This third trigger is a different
# kind of problem: it exists because of something that happens AFTER
# dpkg's unpack has already succeeded cleanly, with no sandbox error at
# all.
#
# nix/compose.nix's composeRootfs writes the composed tree to $out, a Nix
# store path. Nix registers every store path READ-ONLY at build
# completion by canonicalizing its permission bits: every regular file
# becomes exactly 0444, every directory exactly 0555 (see nix/compose.nix's
# own "Nix canonicalizes every registered store path read-only" comment).
# That is normally harmless -- it only ever DROPS bits (0755 -> 0555,
# 0644 -> 0444), and a read-only rootfs does not care that a directory it
# can no longer write to also lost its own write bit in the metadata. But
# a small number of real packages ship a root:root file MORE RESTRICTIVE
# than the canonical mode -- e.g. 0640 or 0600 on something
# secrets-adjacent -- and for THOSE, canonicalization does not merely drop
# bits, it ADDS them: 0640 -> 0444 turns ON other-read; 0600 -> 0444 turns
# ON group-read AND other-read. That is a real permission GRANT the
# package deliberately withheld, silently reintroduced by the packing
# pipeline -- a hardening regression, not a cosmetic metadata loss.
#
# Neither of the first two triggers catches this: the file is root:root
# (the OPPOSITE of the first trigger's condition) and carries no
# setuid/setgid/sticky bit (the second trigger's condition). So this
# script's scan trigger gains a third, independent leg: select an entry,
# even root:root and even with no special bit, if its real permission
# bits are a STRICT SUBSET of the canonical mode for its type (0444 for a
# file/symlink/hardlink, 0555 for a directory) -- i.e. if canonicalization
# would turn ON at least one read (or, for a directory, read/execute) bit
# that the real mode has OFF. See mode_loosens_under_canonicalization()
# below for the exact bitwise rule this implements. It is deliberately
# NOT triggered by the opposite case (real bits a strict SUPERSET of
# canonical, e.g. an ordinary 0755 directory or 0644 file losing bits down
# to 0555/0444): that direction only ever REMOVES access on a tree nothing
# writes to once packed, so recording it would only bloat the pseudo-file
# manifest for no security benefit -- see that function's own comment for
# the concrete bit-math this rests on.
#
# This third trigger reuses the identical downstream mechanism the other
# two already use, completely unchanged: the caller (nix/compose.nix's
# scanLines/restoreLines) path-excludes the entry from dpkg's own
# extraction, restores its real content itself afterward, and records its
# true mode (and owner -- always 0/0 here) in the same mksquashfs
# pseudo-file manifest, applied at PACK time -- well after Nix's own
# canonicalization of the composeRootfs store path has already happened,
# which is exactly why recording it there, rather than merely relying on
# dpkg's in-chroot chmod, is required at all: an in-chroot mode never
# survives past this derivation's own store-path registration, regardless
# of whether dpkg or this script's restore step is what set it. Nothing
# about path-exclude/restore ever depended on dpkg being UNABLE to set the
# mode in the first place -- it only ever depended on some LATER step
# needing the true value recorded somewhere outside the store path that is
# about to be canonicalized. dpkg unpacking one of these entries directly
# would in fact have worked fine (no EINVAL/EPERM survives a plain
# root:root, no-special-bit chmod); routing it through the same
# exclude/restore/pseudo-file path anyway costs one extra targeted
# `tar -x` per selected entry and keeps this script's contract -- and
# nix/compose.nix's caller-side loop -- identical for every selected
# entry, with nothing special-cased at the call site for this third
# reason.
#
# -- Residual risk this script does NOT cover ---------------------------
#
# This only fixes dpkg's OWN unpack-time extraction chowns. A maintainer
# script (preinst/postinst) that itself calls chown/dpkg-statoverride/
# adduser against a non-root id during `dpkg --configure -a` hits the
# exact same EINVAL, and there is no path-exclude equivalent for arbitrary
# script code -- that residual class genuinely needs fakeroot. See this
# project's handback notes (PR #36) for the concrete risk assessment.
#
# -- Why a script, not inline Nix/shell -------------------------------------
#
# Mirrors bin/ubx-gen-grub-cfg's own rationale exactly: this dev harness
# has no `nix`, so a Nix-only implementation could only be checked by
# grepping source text, never by running the logic against a fixture and
# diffing real output. This script needs only `dpkg-deb` and `tar`, both
# already required by nix/compose.nix elsewhere (nix/archive.nix's own
# control-extraction, nix/compose.nix's toolsFHS) -- no new archive
# package, and both are ALSO ordinary host-Ubuntu tools, so
# tests/unit/080-compose-ownership-scan.sh can run it directly against a
# real (test-constructed) fixture .deb on this dev machine, with real
# dpkg-deb/tar, no privilege and no nix required.
#
# -- Output format --------------------------------------------------------
#
# One TAB-separated record per SELECTED entry (non-root-owned, OR carrying
# a setuid/setgid/sticky bit -- see "The MODE follow-up" above -- OR whose
# real permission bits are tighter than Nix's store-path canonicalization
# would leave them -- see "The CANONICALIZATION follow-up" above), to
# stdout:
#   <path><TAB><type><TAB><mode><TAB><uid><TAB><gid>
#   path   absolute install path (e.g. /usr/sbin/pam_extrausers_chkpwd)
#   type   "d" for a directory, "f" for anything else (regular file,
#          symlink, hardlink -- all restored the same way, via a targeted
#          `tar -x` of that one member)
#   mode   4-digit octal permission string (e.g. "2755", "4755"),
#          INCLUDING the setuid/setgid/sticky bits -- parsed from tar's
#          own symbolic mode string, since `tar -tv` has no numeric-mode
#          listing mode. This is always the member's TRUE mode, even
#          though the caller must restore it with the special bits
#          stripped (see "The MODE follow-up" above) -- this manifest
#          field is what carries the true value through to mksquashfs's
#          pack-time pseudo-file pass.
#   uid    numeric owner id, as recorded in the archive
#   gid    numeric group id, as recorded in the archive
# A .deb with no selected entries (the common case -- every proof package
# before PR #36's full-closure boot image) produces empty output and
# exits 0.
set -euo pipefail

prog_name="ubx-scan-deb-ownership"

usage() {
  cat <<USAGE
usage: ubx-scan-deb-ownership DEBFILE

Lists every entry in DEBFILE's data.tar whose recorded owner is not
uid=0/gid=0 (root:root), OR whose recorded mode carries a setuid/setgid/
sticky bit, OR whose recorded permission bits are more restrictive than
Nix's store-path canonicalization would leave them (0444 files, 0555
directories -- see this script's own "CANONICALIZATION follow-up" header
section), one TAB-separated record per line:

  <path><TAB><type><TAB><mode><TAB><uid><TAB><gid>

Pure read-only inspection (dpkg-deb --fsys-tarfile | tar -tv under the
hood) -- no privileges, no mutation, no network. See this script's own
header comment for why it exists (GitHub issue #10 PR #36).
USAGE
}

die() {
  echo "$prog_name: $*" >&2
  exit 1
}

# mode_to_octal SYMBOLIC_MODE — "-rwsr-xr-x" -> "4755", "drwxr-sr-x" ->
# "2755", "-rw-r--r--" -> "0644". Parsed positionally (tar's symbolic mode
# string is always exactly 10 characters: type, then owner/group/other
# rwx triads, with setuid/setgid/sticky folded into the executable
# position as s/S or t/T) rather than via any external tool, so this is
# pure bash -- directly unit-testable, and correct regardless of locale.
mode_to_octal() {
  local m="$1"
  [ "${#m}" -eq 10 ] || die "internal error: unexpected mode string '$m' (want 10 characters)"

  local special=0 owner=0 group=0 other=0
  local r w x

  r="${m:1:1}"; w="${m:2:1}"; x="${m:3:1}"
  [ "$r" = "r" ] && owner=$((owner + 4))
  [ "$w" = "w" ] && owner=$((owner + 2))
  case "$x" in
    x) owner=$((owner + 1)) ;;
    s) owner=$((owner + 1)); special=$((special + 4)) ;;
    S) special=$((special + 4)) ;;
    -) ;;
    *) die "internal error: unexpected owner-exec bit '$x' in mode '$m'" ;;
  esac

  r="${m:4:1}"; w="${m:5:1}"; x="${m:6:1}"
  [ "$r" = "r" ] && group=$((group + 4))
  [ "$w" = "w" ] && group=$((group + 2))
  case "$x" in
    x) group=$((group + 1)) ;;
    s) group=$((group + 1)); special=$((special + 2)) ;;
    S) special=$((special + 2)) ;;
    -) ;;
    *) die "internal error: unexpected group-exec bit '$x' in mode '$m'" ;;
  esac

  r="${m:7:1}"; w="${m:8:1}"; x="${m:9:1}"
  [ "$r" = "r" ] && other=$((other + 4))
  [ "$w" = "w" ] && other=$((other + 2))
  case "$x" in
    x) other=$((other + 1)) ;;
    t) other=$((other + 1)); special=$((special + 1)) ;;
    T) special=$((special + 1)) ;;
    -) ;;
    *) die "internal error: unexpected other-exec bit '$x' in mode '$m'" ;;
  esac

  printf '%d%d%d%d' "$special" "$owner" "$group" "$other"
}

# canonical_digit TYPE_CHAR — the single permission digit (applied
# identically to owner/group/other) Nix's store-path canonicalization
# leaves a path of this tar type with: "5" (r-x) for a directory ("d"),
# "4" (r--) for anything restored the same way a plain file is ("-", "l",
# "h" -- see this script's own type classification below). Empty output
# for any other type (device/fifo/socket): canonicalization is not this
# script's concern for a type it already can't restore at all (see the
# device/fifo/socket die() below), so mode_loosens_under_canonicalization
# must never fire for one.
canonical_digit() {
  case "$1" in
    d) printf '5' ;;
    -|l|h) printf '4' ;;
  esac
}

# mode_loosens_under_canonicalization OCTAL_MODE TYPE_CHAR — true (exit 0)
# iff Nix's post-build store-path canonicalization would SET a permission
# bit that this entry's real, as-shipped mode has OFF, i.e.
# canonicalization would GRANT access the package deliberately withheld
# (GitHub issue #45; see this script's own "CANONICALIZATION follow-up"
# header section for the full writeup and worked examples).
#
# Only the three plain permission digits are compared (OCTAL_MODE's
# leading special digit is skipped entirely): canonicalization never
# touches the setuid/setgid/sticky bit one way or the other (Nix simply
# does not carry a special digit in its own canonical mode at all), and a
# real special bit already selects this entry via the MODE follow-up
# trigger above regardless of what this function returns.
#
# For each of the owner/group/other digits: canonical_digit's bits, ANDed
# against the BITWISE COMPLEMENT of the real digit (masked to 3 bits, so
# bash's arbitrary-width `~` does not leave stray high bits set), is
# nonzero exactly when canonicalization would turn ON a bit ($cdigit) that
# the real mode has OFF ($d) -- e.g. real group digit 0 (`---`), canonical
# group digit 4 (file, `r--`): 4 & ~0 & 7 = 4 & 7 & 7 = 4, nonzero, so a
# 0600 file's group digit alone is enough to select it (its other digit
# would too, independently). Conversely, real owner digit 7 (`rwx`,
# ordinary directory), canonical owner digit 5 (`r-x`): 5 & ~7 & 7 =
# 5 & 0 & 7 = 0 -- an ordinary, LESS restrictive 0755 directory never
# selects here, exactly as required (only a real mode STRICTLY TIGHTER
# than canonical triggers this leg; one merely equal, or looser, must
# not -- see this script's own header for why bloating the manifest with
# the harmless, bits-only-dropped direction is deliberately avoided).
mode_loosens_under_canonicalization() {
  local octal="$1" type="$2"
  local cdigit
  cdigit="$(canonical_digit "$type")"
  [ -n "$cdigit" ] || return 1   # not a file/dir this scan restores at all

  local d
  for d in "${octal:1:1}" "${octal:2:1}" "${octal:3:1}"; do
    if [ $(( cdigit & (~d & 7) )) -ne 0 ]; then
      return 0
    fi
  done
  return 1
}

# A dpkg --path-exclude pattern is a shell glob (dpkg.cfg(5)); we only
# ever want an EXACT match against one known path, so a real glob
# metacharacter in the path would silently exclude more than intended (or
# nothing at all, if the "glob" happens not to match) instead of exactly
# what we scanned. Whitespace is rejected too: the caller writes this
# path, unquoted, as both a `path-exclude=` line AND a field in an
# mksquashfs pseudo-file definition (`-pf`; space/tab-separated, per
# squashfs-tools' own USAGE-MKSQUASHFS.md) -- an embedded space would
# silently corrupt either format's field count. No path in the real
# Ubuntu archive is expected to contain any of these -- fail loudly rather
# than risk a silent mismatch or corrupt record if that assumption is
# ever wrong.
check_safe_path() {
  case "$1" in
    *[\*\?\[]*) die "path contains a dpkg path-exclude glob metacharacter, refusing to build an exclude pattern for it safely: '$1'" ;;
  esac
  case "$1" in
    *[[:space:]]*) die "path contains whitespace, refusing to emit it as a dpkg path-exclude/mksquashfs pseudo-file record: '$1'" ;;
  esac
}

scan() {
  local deb="$1"
  [ -f "$deb" ] || die "no such file: $deb"

  # The tar listing this loop reads is fed via an explicit temp file, NOT
  # a `done < <(...)` process substitution, and NOT a `cmd | while read`
  # pipeline. Two independent constraints rule out the more obvious
  # forms:
  #
  #   - Process substitution (`<(...)`) is implemented by bash opening
  #     /dev/fd/N (or an equivalent named-pipe path threaded through
  #     /dev/fd) and handing that path to the command. nix/compose.nix's
  #     enter.sh runs this script inside a chroot whose only /dev entries
  #     are the explicit bind mounts it lists (null, zero, random,
  #     urandom, ...) plus a freshly mounted /proc -- there is no /dev/fd
  #     and no /proc/self/fd symlink, so bash cannot open the
  #     substitution's fd and the whole scan dies before it reads a
  #     single line (CI run 29953677609: "rootfs-compose-proof>
  #     /.ubx-compose/ubx-scan-deb-ownership: line 180: /dev/fd/63: No
  #     such file or directory"). A plain `< "$tmpfile"` redirect opens an
  #     ordinary regular file and needs no /dev/fd at all.
  #   - `dpkg-deb ... | tar ... | while read ...` would put the loop body
  #     in a subshell (the last stage of a pipeline runs in a subshell in
  #     bash), so every variable this loop's caller relies on afterward
  #     would vanish when the subshell exits. Reading from a temp file
  #     keeps the loop in the current shell.
  # Deliberately NOT `local`: the EXIT trap below fires after this
  # function has already returned (every exit path here, including
  # die()'s inside mode_to_octal()/check_safe_path(), only reliably
  # cleans up $tmp via a process-EXIT trap, not a RETURN one) -- by then a
  # `local` copy of $tmp would already be out of scope, and `set -u`
  # (this script's header) would turn the trap itself into an "unbound
  # variable" error instead of a cleanup. A script-global variable stays
  # visible to the trap for the process's whole remaining lifetime.
  # TMPDIR is forced to /tmp rather than inherited: nix/compose.nix runs
  # this script INSIDE the chroot, but the environment it inherits is the
  # outer Nix builder's, whose TMPDIR (/build) exists only outside that
  # chroot -- bare `mktemp` therefore failed with "failed to create file
  # via template '/build/tmp.XXXXXXXXXX': No such file or directory" (CI
  # run 29955258055). /tmp is guaranteed present and 1777 in the
  # ubuntu-base tree this chroot is built from, and the EXIT trap below
  # removes the file again, so nothing of it survives into the composed
  # rootfs. Outside the chroot (the unit tests' direct invocation) the
  # same /tmp is equally valid, so this needs no conditional.
  tmp="$(TMPDIR=/tmp mktemp)" || die "could not create a temp file for the tar listing"
  trap 'rm -f "$tmp"' EXIT

  # `set -o pipefail` (see this script's `set -euo pipefail` header) makes
  # $? the rightmost-nonzero of dpkg-deb/tar, so a failure in either half
  # of the pipeline still kills the script via `set -e` here, exactly as
  # it would have with the process-substitution form -- the temp-file
  # redirect only changes how the listing reaches the loop below, not how
  # pipeline failure is detected.
  LC_ALL=C dpkg-deb --fsys-tarfile "$deb" | LC_ALL=C tar --numeric-owner -tv > "$tmp"

  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue

    local mode owner rest path
    # `read` folds every field past the named ones into the LAST
    # variable verbatim (see bin/ubx-gen-grub-cfg's identical use of this
    # for kernelParams) -- here that's everything from the size field
    # onward, which this function then re-splits only as far as it needs
    # to (date/time are never used).
    read -r mode owner rest <<<"$line"
    path="${rest#* }"   # drop the size field
    path="${path#* }"   # drop the date field
    path="${path#* }"   # drop the time field

    # Symlinks ("name -> target") and hardlinks ("name link to target")
    # are the only two tar -tv annotations that append extra text after
    # the path; strip either so `path` is the install path alone.
    path="${path%% -> *}"
    path="${path%% link to *}"
    # tar member names are archive-relative ("./usr/sbin/..."); dpkg
    # --path-exclude and mksquashfs pseudo-file entries both want it
    # without the leading "./".
    path="${path#.}"
    path="${path%/}"                     # tar directory entries carry a trailing "/"
    [ -n "$path" ] || continue           # the "./" root entry itself

    local uid="${owner%/*}" gid="${owner#*/}"

    # octal_mode is computed BEFORE the trigger check below (rather than
    # only once an entry is already known to be selected) because, since
    # CI run 29955725327 (see "The MODE follow-up" above), the mode itself
    # is now part of deciding whether to select this entry at all -- not
    # just something recorded once a non-root owner already selected it.
    local octal_mode
    octal_mode="$(mode_to_octal "$mode")"
    local special="${octal_mode%???}"   # the leading (setuid/setgid/sticky) digit alone

    # raw_type is computed here (rather than only once an entry is already
    # selected) for the same reason octal_mode is computed early, above:
    # since GitHub issue #45's canonicalization trigger (below), the
    # entry's TYPE, not just its mode, is now part of deciding whether to
    # select it at all -- the canonical mode compared against differs for
    # a directory (0555) vs. a plain file/symlink/hardlink (0444).
    local raw_type="${mode:0:1}"

    # Select this entry if EITHER its owner is not root:root (the original
    # trigger -- dpkg's unconditional chown() fails EINVAL under this
    # sandbox's single-id-mapped user namespace) OR its mode carries a
    # setuid/setgid/sticky bit (the mode follow-up -- dpkg's unconditional
    # chmod() to set that bit fails EPERM under the same sandbox,
    # independent of who owns the file: /usr/bin/mount, root:root, 4755,
    # is the concrete CI failure this exists for) OR its real permission
    # bits are tighter than Nix's store-path canonicalization would leave
    # them (the canonicalization follow-up, GitHub issue #45: a root:root,
    # no-special-bit file like a 0600/0640 secret would otherwise emerge
    # from the packed image WORLD-READABLE -- see
    # mode_loosens_under_canonicalization()'s own comment for the exact
    # bitwise rule). None of the three conditions alone is "this script's
    # concern" the way the very first version of this comment put it --
    # all three now are.
    if [ "$uid/$gid" = "0/0" ] && [ "$special" = "0" ] &&
       ! mode_loosens_under_canonicalization "$octal_mode" "$raw_type"; then
      continue
    fi

    # Only entries we're ABOUT to ask the caller to path-exclude-then-
    # restore need a restorable type: a device/fifo/socket tar entry would
    # need mknod(2) to recreate, which this build sandbox already refuses
    # regardless of ownership (nix/compose.nix's own /dev bind-mount
    # comment: "Nix refuses to register device nodes in store paths") --
    # so a selected one is doubly unsupported. Checked here, not earlier,
    # so a root:root, non-special-mode device/fifo/socket entry (outside
    # this script's remit entirely) is never flagged by it.
    local type="$raw_type"
    case "$type" in
      d) type="d" ;;
      -|l|h) type="f" ;;
      *)
        die "$deb: '$path' is a selected (non-root-owned and/or set*id/sticky and/or canonicalization-loosened) device/fifo/socket tar entry (mode '$mode', owner $uid/$gid) -- this script has no safe way to restore it (mknod is refused inside this project's build sandbox; see nix/compose.nix's own /dev bind-mount comment), and no package in this project's locked archive set is expected to ship one. Investigate before adding a package that does."
        ;;
    esac

    check_safe_path "$path"

    printf '%s\t%s\t%s\t%s\t%s\n' "$path" "$type" "$octal_mode" "$uid" "$gid"
  done < "$tmp"
}

main() {
  [ $# -eq 1 ] || { usage >&2; die "expected exactly one argument (DEBFILE), got $#"; }
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
  esac
  scan "$1"
}

main "$@"
