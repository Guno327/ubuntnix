#!/usr/bin/env bash
# bin/ubx-secrets-apply — secrets-primitive activation EXECUTOR (SPEC.md
# §8.1 "Secrets (decided design)", §4.3 switching-table "none" downtime;
# GitHub issue #78, milestone M4). The secrets-domain sibling of
# bin/ubx-etc-apply/bin/ubx-systemd-apply/bin/ubx-snap-apply, deliberately
# thin and dumb the same way: consumes a plan `bin/ubx-secrets plan` emits
# (see that script's header for the schema and the full planning algorithm)
# and issues the corresponding filesystem calls, IN THE PLAN'S OWN ORDER
# (materialize, then env, then symlink -- matching bin/ubx-secrets' own
# emission order). All the intelligence lives in the planner; this script
# never recomputes, re-derives, or second-guesses a single decision the
# plan already made.
#
# -- Content source: --secrets-dir/<name> ------------------------------------
#
# The plan itself carries no secret bytes at all (bin/ubx-secrets' own
# header, "Why content is never diffed here"), only metadata + paths. Real
# material is resolved HERE, by declared NAME, exactly the same
# "--content-dir/PATH" convention bin/ubx-etc-apply already establishes for
# `/etc` content and bin/ubx-snap-apply's "--payload-dir/<name>_<revision>"
# convention establishes for snap payloads (see both scripts' own headers):
#   --secrets-dir DIR/<name>   the decrypted secret material for <name>
# `--secrets-dir` defaults to "." (mirrors --content-dir's own default). A
# real activation is expected to point this at the git-crypt-decrypted
# `secrets/` working tree (SPEC.md §8.1) once GitHub issue #79 (git-crypt
# onboarding) exists; nix/secrets.nix's own `src` field is NOT consulted by
# this pipeline today -- a documented, tracked gap (see that file's header).
#
# -- The canonical-copy model, and why paths are RECONSTRUCTED, not read
#    verbatim off the plan -----------------------------------------------
#
# Every declared secret's real material lands at exactly one canonical
# path, `--run-secrets-dir/<name>` (default /run/secrets/<name>, tmpfs) --
# see bin/ubx-secrets' own header, "The canonical-copy model", for why a
# custom `dst` is delivered as an ADDITIONAL symlink to that copy, never a
# second real copy. The plan's own `materialize`/`env` entries carry a
# `dst`/`path` field already resolved to the DEFAULT `/run/secrets/...`
# root (nix/secrets.nix/bin/ubx-secrets both assume the real, default root)
# -- this executor deliberately RECONSTRUCTS the real target from
# `--run-secrets-dir` + the entry's own `name` instead of trusting that
# literal string verbatim, exactly so `--run-secrets-dir` can point at a
# temp directory in tests without the plan itself needing to know about
# it (mirrors bin/ubx-etc-apply's own `--etc-dir` override, which
# similarly never trusts a plan path as the final answer). A `symlink`
# entry's `path` is NOT reconstructed this way -- it is a genuine,
# arbitrary absolute filesystem location the declared secret's own custom
# `dst` named (e.g. /etc/wireguard/wg0.key), used verbatim; only its
# `target` (the canonical copy it must point at) is reconstructed the same
# way.
#
# -- Env-file rendering: value never appears in the printed command list ----
#
# `environmentVariable = "VAR"` additionally renders `<canonical>.env`
# containing `VAR=<value>` (SPEC.md §8.1). Unlike every other action here
# (which shell out to `install`/`chmod`/`chown`/`rm`/`ln`, none of which
# ever need to embed a secret's actual BYTES in their own argv), rendering
# this file needs the real value -- so it is never inlined into the
# --dry-run-printed command text (which this script's own tests, and any
# operator watching --dry-run output, may reasonably expect to be safe to
# paste into a bug report). Instead, `ubx_secrets_render_env` (defined
# once, below) is invoked as `ubx_secrets_render_env VAR SRC DST OWNER
# GROUP MODE CAN_CHOWN` -- an argv of paths/names ONLY -- and reads/writes
# the real value itself, at the moment the temp script actually runs
# (--apply only); in --dry-run mode this line is printed BUT NEVER
# EXECUTED, exactly like every other command this script emits.
#
# -- Persistent-filesystem warning (SPEC.md §8.1) ----------------------------
#
# "a `dst` on a persistent filesystem is honored but loudly warned about,
# since the material then survives reboot outside tmpfs." Checked here,
# independent of --apply/--dry-run (mirrors bin/ubx-etc-apply's own `drift`
# lines: always printed to stderr, in BOTH modes, never gated on whether
# anything is actually written) by reading a mounts table (`--mounts-file`,
# default /proc/self/mounts -- overridable so tests can supply a fixture
# with no real mount access needed) and finding the LONGEST matching
# mountpoint prefix for the symlink's own directory; anything other than
# `tmpfs` (including "no matching mountpoint found", a conservative
# default -- this check is a best-effort diagnostic, not a hard gate) is
# reported. A default `dst` (no symlink at all, the file materializes
# directly on `--run-secrets-dir`'s own tmpfs) never triggers this --
# there is nothing to warn about.
#
# -- Privilege: testable without root, real ownership only as root ----------
#
# Exactly bin/ubx-etc-apply's own posture (see that script's header): owner/
# group are only ever applied when this process's effective uid is 0;
# `mode` (chmod) is always applied regardless of privilege.
set -euo pipefail

prog_name="ubx-secrets-apply"

die() {
  echo "$prog_name: $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
usage: ubx-secrets-apply --plan FILE [--secrets-dir DIR] [--run-secrets-dir DIR] [--mounts-file FILE] [--apply | --dry-run]

Consumes a plan produced by `bin/ubx-secrets plan` and issues the
corresponding install/chown/chmod/rm/ln calls, in the plan's own order
(materialize, env, symlink).

  --plan FILE            the plan JSON to apply (required)
  --secrets-dir DIR       where a materialize/env action's real secret
                          bytes are read from, as DIR/<name> (default ".")
  --run-secrets-dir DIR   the real (or, for tests, temp) canonical root
                          every materialize/env action targets, as
                          DIR/<name> / DIR/<name>.env (default /run/secrets)
  --mounts-file FILE      the mount table consulted for the persistent-
                          filesystem warning (default /proc/self/mounts)
  --apply                 actually run commands
  --dry-run               print, don't run (default)

Owner/group are only ever applied when running as root (euid 0) -- see
this script's header, "Privilege". The persistent-filesystem warning is
always printed to stderr, in both modes -- see this script's header.
USAGE
}

main() {
  local plan="" secrets_dir="." run_secrets_dir="/run/secrets" mounts_file="/proc/self/mounts" mode="dry-run"
  while [ $# -gt 0 ]; do
    case "$1" in
      --plan) [ $# -ge 2 ] || die "--plan requires an argument"; plan="$2"; shift 2 ;;
      --secrets-dir) [ $# -ge 2 ] || die "--secrets-dir requires an argument"; secrets_dir="$2"; shift 2 ;;
      --run-secrets-dir) [ $# -ge 2 ] || die "--run-secrets-dir requires an argument"; run_secrets_dir="$2"; shift 2 ;;
      --mounts-file) [ $# -ge 2 ] || die "--mounts-file requires an argument"; mounts_file="$2"; shift 2 ;;
      --apply) mode="apply"; shift ;;
      --dry-run) mode="dry-run"; shift ;;
      -h | --help) usage; exit 0 ;;
      *) echo "$prog_name: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done
  [ -n "$plan" ] || die "--plan is required"
  [ -f "$plan" ] || die "no such file: $plan"

  local can_chown=0
  [ "$(id -u)" != 0 ] || can_chown=1

  # -- persistent-filesystem warning: always evaluated, always printed to
  # stderr immediately, independent of --apply/--dry-run (this script's
  # header, "Persistent-filesystem warning").
  python3 - "$plan" "$run_secrets_dir" "$mounts_file" <<'WARNEOF'
import json
import os
import sys

plan_path, run_secrets_dir, mounts_file = sys.argv[1:4]

with open(plan_path, encoding="utf-8") as f:
    plan = json.load(f)


def read_mounts(path):
    mounts = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                fields = line.split()
                if len(fields) >= 3:
                    mounts.append((fields[1], fields[2]))
    except OSError:
        return []
    return mounts


def fstype_for(path, mounts):
    best_mp, best_type = None, None
    for mp, fstype in mounts:
        if path == mp or path.startswith(mp.rstrip("/") + "/") or mp == "/":
            if best_mp is None or len(mp) > len(best_mp):
                best_mp, best_type = mp, fstype
    return best_type


mounts = read_mounts(mounts_file)

for entry in plan.get("symlink", {}).get("create", []):
    target_dir = os.path.dirname(entry["path"])
    fstype = fstype_for(target_dir, mounts)
    if fstype != "tmpfs":
        print(
            f"{'ubx-secrets-apply'}: WARNING: secret '{entry['name']}' dst "
            f"{entry['path']!r} is on a {fstype or 'UNKNOWN'} filesystem, not "
            "tmpfs -- the material now persists across reboots outside "
            "tmpfs (SPEC.md §8.1)",
            file=sys.stderr,
        )
WARNEOF

  local commands
  commands="$(python3 - "$plan" "$secrets_dir" "$run_secrets_dir" "$can_chown" <<'PYEOF'
import json
import shlex
import sys

plan_path, secrets_dir, run_secrets_dir, can_chown = sys.argv[1:5]
can_chown = can_chown == "1"

with open(plan_path, encoding="utf-8") as f:
    plan = json.load(f)

lines = []


def emit(argv):
    lines.append(" ".join(shlex.quote(a) for a in argv))


def canonical(name):
    return f"{run_secrets_dir}/{name}"


for e in plan.get("materialize", {}).get("create", []) + plan.get("materialize", {}).get("update", []):
    name = e["name"]
    src = f"{secrets_dir}/{name}"
    dst = canonical(name)
    argv = ["install", "-D", "-m", e["mode"]]
    if can_chown:
        argv += ["-o", e["owner"], "-g", e["group"]]
    argv += [src, dst]
    emit(argv)

for e in plan.get("materialize", {}).get("remove", []):
    emit(["rm", "-f", canonical(e["name"])])

for e in plan.get("env", {}).get("create", []) + plan.get("env", {}).get("update", []):
    name = e["name"]
    src = f"{secrets_dir}/{name}"
    dst = f"{canonical(name)}.env"
    var = e.get("environmentVariable") or (e.get("changes", {}).get("environmentVariable", {}).get("to"))
    owner = e.get("owner", "root")
    group = e.get("group", "root")
    fmode = e.get("mode", "0400")
    emit(["ubx_secrets_render_env", var, src, dst, owner, group, fmode, "1" if can_chown else "0"])

for e in plan.get("env", {}).get("remove", []):
    emit(["rm", "-f", f"{canonical(e['name'])}.env"])

for e in plan.get("symlink", {}).get("create", []):
    path = e["path"]
    target = canonical(e["name"])
    emit(["mkdir", "-p", "--", path.rsplit("/", 1)[0] or "/"])
    emit(["ln", "-sfn", "--", target, path])

print("\n".join(lines))
PYEOF
  )"

  if [ "$mode" = "dry-run" ]; then
    if [ -n "$commands" ]; then
      printf '%s\n' "$commands"
    fi
    exit 0
  fi

  # --apply: run each command line via a temp script, same pattern
  # bin/ubx-etc-apply's own --apply branch uses (see tests/unit/137's
  # header for exactly why $script is expanded NOW, double-quoted, rather
  # than lazily at EXIT-trap-fire time). `ubx_secrets_render_env` is
  # defined inline so the emitted command lines above can invoke it by
  # name without ever embedding a secret's real value in their own text
  # (this script's header, "Env-file rendering").
  local script
  script="$(mktemp)"
  # shellcheck disable=SC2064  # intentional: expand $script NOW
  trap "rm -f '$script'" EXIT
  {
    printf '#!/bin/sh\nset -e\n'
    cat <<'FUNCEOF'
ubx_secrets_render_env() {
  # NOTE: the 0177 umask below is scoped to a SUBSHELL (the `(...)` around
  # the write), deliberately -- `umask` is a shell-wide setting with no
  # per-function scope in POSIX sh; setting it directly in this function's
  # own body would leak into every command the REST of this temp script
  # runs afterwards (e.g. a subsequent `mkdir -p` for a symlink's parent
  # directory would silently come out with no execute bit at all,
  # rendering it untraversable even by its own owner). The explicit
  # `chmod` right after already applies the real target mode regardless of
  # umask, so the subshell's umask only ever matters for the brief instant
  # between file creation and that chmod.
  var="$1"; src="$2"; dst="$3"; owner="$4"; group="$5"; fmode="$6"; can_chown="$7"
  value="$(cat "$src")"
  ( umask 0177; printf '%s=%s\n' "$var" "$value" > "$dst" )
  chmod "$fmode" "$dst"
  if [ "$can_chown" = 1 ]; then
    chown "$owner:$group" "$dst"
  fi
}
FUNCEOF
    printf '%s\n' "$commands"
  } > "$script"
  chmod +x "$script"
  "$script"
}

main "$@"
