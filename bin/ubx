#!/usr/bin/env bash
# ubx — the ubuntnix CLI (full name: ubuntnix; alias: ubx). See SPEC.md
# §4.5 for the on-device tooling contract, §4.3 for the switch/boot/test
# verb semantics, and §7 for the converge-report posture this orchestrator
# feeds. GitHub issue #29, milestone M2.
#
# -- What this file orchestrates, and what it deliberately does NOT --------
#
# `rebuild switch|boot|test`, `rollback`, `list-generations`, and `diff`
# are REAL here: they shell out to the already-implemented, independently
# unit-tested primitives this repo built for exactly this purpose —
# bin/ubx-generations (the generation model), bin/ubx-etc / bin/ubx-systemd
# / bin/ubx-users (each domain's plan/observe/execute split) — in a fixed,
# deterministic order, and add the two things none of those tools owns:
# the GRUB-default matrix (switch/boot set it, test never does — the most
# important behavior this issue adds) and a combined, deterministic
# touched-domains report.
#
# This is NOT a real activation engine end to end. Two things are
# explicitly stubbed/deferred, called out loudly rather than silently
# half-implemented:
#   - On-device Nix evaluation/composition (building a rootfs image, an
#     `/etc` tree, a systemd unit tree from the flake) does not exist yet
#     (nix/compose.nix has no etc/systemd wiring). `rebuild`'s generation-
#     creation flags (--rootfs-image, --etc-ref, --systemd-ref, ...) are
#     the seam: today a caller (a human, or later, real build machinery)
#     supplies already-built store paths/manifest files directly; nothing
#     here invokes `nix` itself. See bin/ubx-rebuild-lib's header for how
#     a domain ref is resolved once supplied.
#   - Soft-reboot into a changed rootfs image (SPEC.md §4.3's "Deb set...
#     build new image -> systemctl soft-reboot into it") IS implemented as
#     of issue #30: `switch` classifies the delta between the old and new
#     generation's rootfs image/kernel store paths
#     (ubx_rebuild_classify_delta in bin/ubx-rebuild-lib) and, when only
#     the image changed, invokes an injectable reboot command (default
#     `systemctl soft-reboot`, overridable via UBX_SOFT_REBOOT_CMD for
#     testing). A kernel change always falls back to demanding a full,
#     manual reboot (never auto-triggered) per SPEC.md §4.3/§12 R3 — full
#     reboot is the always-correct fallback this project never overrides.
#     `test` never reboots (a plain reboot already returns to the last-
#     good generation). Issue #55 closed the gap issue #30 left open: the
#     new generation's rootfs squashfs image (GEN_ROOTFS_IMAGE) is now
#     mounted read-only at /run/nextroot (an injectable
#     UBX_NEXTROOT_STAGE_CMD, mirroring UBX_SOFT_REBOOT_CMD) immediately
#     before the reboot call, so `systemctl soft-reboot` — which requires
#     systemd >= 254 and only re-execs into /run/nextroot when it is
#     already populated — actually lands on the new image instead of just
#     restarting the same userspace in place.
#     tests/e2e/020-qemu-switch-e2e.sh's scenario 2 now drives this real
#     staging step too: the guest builds a real squashfs image at runtime
#     and lets `ubx rebuild switch` really `mount` it at /run/nextroot
#     (UBX_NEXTROOT_STAGE_CMD left unset -- its real default runs), then
#     asserts that landed, before tearing it down again. What remains a
#     documented stub: the actual `systemctl soft-reboot` re-exec call
#     itself, which still goes through a marker-dropping stub, because
#     really re-execing into /run/nextroot needs a full second bootable
#     userspace staged there (systemd, every binary the driver depends on
#     to keep running post-re-exec) -- see nix/boot.nix's switch-loop-proof
#     section header for exactly why that is out of scope here.
# Live activation of the three domains this orchestrator DOES run
# end-to-end is itself gated by how far each domain's own executor got in
# its own issue: bin/ubx-etc-apply and bin/ubx-systemd-apply are both real
# (dry-run-by-default, `--apply`-gated) executors (issue #54 added the
# former, mirroring the latter's own pattern almost exactly — see
# bin/ubx-etc-apply's header); bin/ubx-users' `execute` only ever EMITS a
# shell script (per that script's own header, never runs it). This
# orchestrator calls exactly as much of each as exists today and prints a
# clear notice for the rest — it never invents execution machinery that
# belongs to those other issues.
set -euo pipefail

prog_name="ubuntnix (ubx)"
bindir="$(cd "$(dirname "$0")" && pwd)"
UBX_REBUILD_LIB_PROG="$prog_name"
export UBX_REBUILD_LIB_PROG
# shellcheck source=bin/ubx-rebuild-lib
. "$bindir/ubx-rebuild-lib"

# The soft-reboot command `do_rebuild` invokes for an image-only delta
# (issue #30) — overridable so unit tests can substitute a stub script
# that records its invocation instead of actually calling systemd's real
# `soft-reboot` (which this test harness's containers/CI runners have
# neither the privilege nor the systemd version for). Never consulted for
# a kernel or live-only delta, `ubx rebuild test`, or any --dry-run.
#
# systemd's soft-reboot mechanism (`systemctl soft-reboot`) requires
# systemd >= 254: that is the first release able to re-exec userspace into
# a populated /run/nextroot at all (older systemd's `soft-reboot` verb
# either does not exist or always just restarts the SAME userspace in
# place, silently never picking up the new generation's image). This
# project targets Ubuntu 24.04 "noble" (systemd 255), so the minimum is
# already met on every image this repo builds; a caller running this on an
# older base must not expect the reboot below to actually land on the new
# image even though it exits 0.
UBX_SOFT_REBOOT_CMD="${UBX_SOFT_REBOOT_CMD:-systemctl}"

# Where the new generation's rootfs squashfs image is staged before the
# soft-reboot call above (issue #55) — systemd's soft-reboot mechanism
# re-execs userspace into /run/nextroot IFF that path is already populated
# (a mounted tree) at the moment `systemctl soft-reboot` runs; otherwise it
# just restarts the same userspace in place and the new image is never
# actually activated. Not itself overridable (this is systemd's own fixed
# contract, not a project choice) — UBX_NEXTROOT_STAGE_CMD below is the
# injectable seam.
UBX_NEXTROOT_DIR="${UBX_NEXTROOT_DIR:-/run/nextroot}"

# The staging command invoked to populate $UBX_NEXTROOT_DIR — mirrors
# UBX_SOFT_REBOOT_CMD immediately above: overridable so unit tests can
# substitute a stub script that records "IMAGE TARGET" instead of actually
# mounting anything (this test harness's containers/CI runners have
# neither the privilege nor, in general, a mounted squashfs image to mount
# for real). Invoked as `"$UBX_NEXTROOT_STAGE_CMD" IMAGE TARGET`, exactly
# once, immediately BEFORE UBX_SOFT_REBOOT_CMD, and gated identically to
# it: only `rebuild switch` with an `image`-class delta, never `test`, a
# `kernel`/`live-only` delta, or any --dry-run. Defaults to the internal
# _ubx_stage_nextroot function (below) rather than a bare external command
# name, since staging needs two positional args in a fixed order — a
# real override still just names a command/script taking the same two
# args, exactly like a UBX_SOFT_REBOOT_CMD stub does today.
UBX_NEXTROOT_STAGE_CMD="${UBX_NEXTROOT_STAGE_CMD:-_ubx_stage_nextroot}"

# _ubx_stage_nextroot IMAGE TARGET — the real default UBX_NEXTROOT_STAGE_CMD:
# mounts IMAGE (a squashfs rootfs image, from the new generation's own
# GEN_ROOTFS_IMAGE manifest field) read-only at TARGET, creating TARGET
# first if it does not already exist. All-Canonical: mount(8) and squashfs
# kernel/tooling support are both base Ubuntu — no nixpkgs binary involved.
_ubx_stage_nextroot() {
  local image="$1" target="$2"
  mkdir -p "$target"
  mount -t squashfs -o ro "$image" "$target"
}

die() {
  echo "ubx: $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
usage: ubx <command> [args]

commands:
  rebuild <switch|boot|test> [options]  build/register a generation and
                                         (per verb) activate it live and/or
                                         set the GRUB default
  rollback [N] [options]                 re-converge live domains to
                                          "previous" (default) or generation
                                          N, and move the GRUB default back
  list-generations [options]             list available generations
  diff [A] [B] [options]                 show the domain-level delta
                                          between two generations (default:
                                          previous vs. current)
  update                                  refresh lockfiles (flake/archive/
                                          snap pins)
  help, --help                           show this message

Run 'ubx <command> --help' for a command's own options. See SPEC.md §4.3,
§4.5 for the verb semantics this implements.

$prog_name: 'update' is still a pre-M1 stub (SPEC.md §11).
USAGE
}

not_implemented() {
  echo "ubx: $1: not implemented (pre-M1)" >&2
  exit 1
}

# =====================================================================
# shared plan/report/execute helpers
#
# Domain order is FIXED throughout this file: etc, systemd, users, snap —
# mirrors SPEC.md §4.3's switching table (row 1 combines /etc + systemd
# units, row 2 is users, row 3 is snaps) and matches the position
# bin/ubx-snap-purge's own sweep already established at the end of
# execute_domains (issue #66). Every report this script prints lists
# domains in exactly this order, regardless of which verb produced it.
# =====================================================================

peek_next_index() { # ROOT
  local root="$1"
  if [ -f "$root/.next-index" ]; then
    cat "$root/.next-index"
  else
    echo 1
  fi
}

# summarize_etc_plan PLAN_TSV — prints "ACTIONABLE<TAB>DRIFT" counts.
summarize_etc_plan() {
  awk -F'\t' '
    $1 == "drift" { d++; next }
    NF > 0 { a++ }
    END { printf "%d\t%d\n", a + 0, d + 0 }
  ' "$1"
}

# summarize_systemd_plan PLAN_JSON — prints the action count. Each action
# object in the plan's pretty-printed JSON contributes exactly one `"op":`
# line (the top-level object has no such key of its own), so a plain grep
# count needs no python3 invocation just to count.
summarize_systemd_plan() {
  grep -c '"op":' "$1" || true
}

# systemd_synthesize_observed OLD_DECLARED_JSON OUT_JSON — the systemd
# domain's "assume no drift" default observed-state manifest, derived FROM
# the old generation's own DECLARED manifest (bin/ubx-systemd's declared
# and observed schemas are NOT the same shape — unlike bin/ubx-etc's,
# where both sides share one "entries" schema and the old manifest can be
# reused as-is; see bin/ubx-systemd's header for the two distinct
# schemas). This synthesizes the observed shape a fully-converged system
# running exactly the old declaration would report: a unit's sha256 is
# only present when the old entry `hasContent`; `enabled`/`masked` mirror
# `enable`/`mask` directly; `active` is approximated as "enabled and not
# masked" (the common case for a converged unit) — a caller who needs a
# real, live-observed answer instead passes --systemd-observed (fed from a
# real `ubx-systemd observe`), bypassing this synthesis entirely.
systemd_synthesize_observed() {
  python3 - "$1" "$2" <<'PYEOF'
import json
import sys

old_path, out_path = sys.argv[1:3]
with open(old_path, encoding="utf-8") as f:
    old = json.load(f)

units = []
for u in old.get("units", []):
    enable = bool(u.get("enable", False))
    mask = bool(u.get("mask", False))
    units.append({
        "name": u["name"],
        "sha256": u["sha256"] if u.get("hasContent") else None,
        "enabled": enable,
        "masked": mask,
        "active": enable and not mask,
    })

with open(out_path, "w", encoding="utf-8") as f:
    json.dump({"version": 1, "units": units}, f, indent=2)
    f.write("\n")
PYEOF
}

# summarize_snap_plan PLAN_JSON — prints the action count. Same technique
# as summarize_systemd_plan (bin/ubx-snap's plan JSON is pretty-printed the
# same way bin/ubx-systemd's is: each action object contributes exactly one
# `"op":` line, and the top-level object has no such key of its own).
summarize_snap_plan() {
  grep -c '"op":' "$1" || true
}

# snap_synthesize_observed OLD_DECLARED_JSON OUT_JSON — the snap domain's
# "assume no drift" default observed-state manifest, derived FROM the old
# generation's own DECLARED manifest — chosen over an `ubx-snap observe`
# call for the same reason systemd_synthesize_observed (above) is chosen
# over a live `ubx-systemd observe`: this is the "no caller-supplied
# observed state" DEFAULT, and shelling out to the real, impure
# UBX_SNAP_QUERY_CMD seam (which talks to the host's own `snap` client) is
# neither expected to be available nor desired every time a plan is merely
# being computed against an assumed-converged baseline; a caller who wants
# a real, live-observed answer instead passes --snap-observed (fed from a
# real `ubx-snap observe`), bypassing this synthesis entirely, exactly
# mirroring --systemd-observed.
#
# Unlike bin/ubx-systemd's declared/observed schemas (which genuinely
# differ in shape — see systemd_synthesize_observed's own comment), bin/
# ubx-snap's declared and observed per-snap schemas share almost the same
# fields verbatim (channel/revision/classic/connections/config — see that
# script's header for both schemas side by side): the only observed-only
# addition is the top-level `refreshHold` flag. So this synthesis is a
# straight copy of the old manifest's declared snaps into the observed
# shape, plus `refreshHold: true` (a fully-converged system, per SPEC.md
# §4.3's "auto-refresh held permanently" invariant, already holds it).
snap_synthesize_observed() {
  python3 - "$1" "$2" <<'PYEOF'
import json
import sys

old_path, out_path = sys.argv[1:3]
with open(old_path, encoding="utf-8") as f:
    old = json.load(f)

snaps = []
for s in old.get("snaps", []):
    snaps.append({
        "name": s["name"],
        "revision": s["revision"],
        "channel": s["channel"],
        "classic": bool(s.get("classic", False)),
        "connections": list(s.get("connections", [])),
        "config": dict(s.get("config", {})),
    })

with open(out_path, "w", encoding="utf-8") as f:
    json.dump({"version": 1, "refreshHold": True, "snaps": snaps}, f, indent=2)
    f.write("\n")
PYEOF
}

# summarize_users_plan PLAN_JSON — prints "ACTIONABLE<TAB>DRIFT<TAB>ERRORS".
summarize_users_plan() {
  python3 - "$1" <<'PYEOF'
import json
import sys

p = json.load(open(sys.argv[1], encoding="utf-8"))
n = (
    len(p["users"]["create"]) + len(p["users"]["modify"])
    + len(p["groups"]["create"]) + len(p["membership"]["add"])
    + len(p["membership"]["remove"]) + len(p["authorized_keys"])
)
print(f"{n}\t{len(p['drift'])}\t{len(p['errors'])}")
PYEOF
}

# users_plan_report PLAN_JSON — a human-readable render of a users plan
# (bin/ubx-users has no `report` subcommand of its own, unlike
# bin/ubx-systemd — this is that missing piece, kept local to bin/ubx
# since nothing else needs it).
users_plan_report() {
  python3 - "$1" <<'PYEOF'
import json
import sys

p = json.load(open(sys.argv[1], encoding="utf-8"))
lines = []
for u in p["users"]["create"]:
    lines.append(f"create user: {u['name']}")
for u in p["users"]["modify"]:
    lines.append(f"modify user: {u['name']} ({', '.join(sorted(u['changes']))})")
for g in p["groups"]["create"]:
    lines.append(f"create group: {g['name']}")
for m in p["membership"]["remove"]:
    lines.append(f"remove membership: {m['user']} from {m['group']}")
for m in p["membership"]["add"]:
    lines.append(f"add membership: {m['user']} to {m['group']}")
for a in p["authorized_keys"]:
    lines.append(f"authorized_keys: {a['user']}")

if not lines and not p["drift"] and not p["errors"]:
    print("users: nothing to do (fully converged)")
else:
    print(f"users: {len(lines)} action(s) planned:")
    for line in lines:
        print(f"  - {line}")
    if p["drift"]:
        print(f"  drift ({len(p['drift'])}): " + json.dumps(p["drift"], sort_keys=True))
    if p["errors"]:
        print(f"  ERRORS ({len(p['errors'])}): " + json.dumps(p["errors"], sort_keys=True))
PYEOF
}

# -- plan_domains: computes (never executes) the three domain plans -------
#
# Reads DOM_OLD_* / DOM_NEW_* (refs, may be empty) plus the observed/
# exceptions overrides below from already-set variables, and sets:
#   DOM_ETC_PLAN / DOM_SYSTEMD_PLAN / DOM_USERS_PLAN   (file path, or "")
#   DOM_ETC_SKIP / DOM_SYSTEMD_SKIP / DOM_USERS_SKIP    (0/1)
#   DOM_ETC_TOUCH DOM_ETC_DRIFT
#   DOM_SYSTEMD_TOUCH
#   DOM_USERS_TOUCH DOM_USERS_DRIFT
#   DOM_NEW_ETC_JSON       (the resolved new etc manifest.json path, used as
#                           a --content-dir default at execute time, exactly
#                           DOM_NEW_SYSTEMD_JSON's own role for the systemd
#                           domain)
#   DOM_NEW_SYSTEMD_JSON   (the resolved new systemd manifest.json path,
#                           used as a --content-dir default at execute time)
# A domain is SKIPPED (no plan computed) only when NEITHER the old nor the
# new ref names anything — "never declared, on either side" (matches
# bin/ubx-generations' own "legally empty" fields posture). Dies (via
# `die`, propagating the failing tool's own stderr) on a hard planner
# refusal (an etc/systemd manifest naming an exception path with a
# disagreeing refuseRestart flag; a users plan reporting a foreign uid/gid
# conflict).
plan_domains() {
  local workdir="$1"

  DOM_ETC_SKIP=0
  if [ -z "$DOM_OLD_ETC_REF" ] && [ -z "$DOM_NEW_ETC_REF" ]; then
    DOM_ETC_SKIP=1
  fi
  if [ "$DOM_ETC_SKIP" = 0 ]; then
    local etc_old_json etc_new_json etc_obs_json
    etc_old_json="$(ubx_rebuild_resolve_ref "$DOM_OLD_ETC_REF" "$UBX_REBUILD_EMPTY_ETC_MANIFEST" "$workdir" old-etc)" \
      || die "could not resolve the old generation's etc manifest"
    etc_new_json="$(ubx_rebuild_resolve_ref "$DOM_NEW_ETC_REF" "$UBX_REBUILD_EMPTY_ETC_MANIFEST" "$workdir" new-etc)" \
      || die "could not resolve the new generation's etc manifest"
    etc_obs_json="$etc_old_json"
    [ -z "${OPT_ETC_OBSERVED:-}" ] || etc_obs_json="$OPT_ETC_OBSERVED"

    DOM_ETC_PLAN="$workdir/etc-plan.tsv"
    local etc_args=("$bindir/ubx-etc" plan --old-manifest "$etc_old_json" --new-manifest "$etc_new_json" \
      --observed-manifest "$etc_obs_json" --out "$DOM_ETC_PLAN")
    if [ -n "${OPT_ETC_EXCEPTIONS:-}" ]; then
      etc_args+=(--exceptions "$OPT_ETC_EXCEPTIONS")
    fi
    "${etc_args[@]}" || die "ubx-etc plan refused (see its stderr above)"
    IFS=$'\t' read -r DOM_ETC_TOUCH DOM_ETC_DRIFT < <(summarize_etc_plan "$DOM_ETC_PLAN")
    DOM_NEW_ETC_JSON="$etc_new_json"
  else
    DOM_ETC_PLAN=""
    DOM_ETC_TOUCH=0
    DOM_ETC_DRIFT=0
    DOM_NEW_ETC_JSON=""
  fi

  DOM_SYSTEMD_SKIP=0
  if [ -z "$DOM_OLD_SYSTEMD_REF" ] && [ -z "$DOM_NEW_SYSTEMD_REF" ]; then
    DOM_SYSTEMD_SKIP=1
  fi
  if [ "$DOM_SYSTEMD_SKIP" = 0 ]; then
    local sysd_old_json sysd_new_json sysd_obs_json
    sysd_old_json="$(ubx_rebuild_resolve_ref "$DOM_OLD_SYSTEMD_REF" "$UBX_REBUILD_EMPTY_SYSTEMD_MANIFEST" "$workdir" old-systemd)" \
      || die "could not resolve the old generation's systemd manifest"
    sysd_new_json="$(ubx_rebuild_resolve_ref "$DOM_NEW_SYSTEMD_REF" "$UBX_REBUILD_EMPTY_SYSTEMD_MANIFEST" "$workdir" new-systemd)" \
      || die "could not resolve the new generation's systemd manifest"
    if [ -n "${OPT_SYSTEMD_OBSERVED:-}" ]; then
      sysd_obs_json="$OPT_SYSTEMD_OBSERVED"
    else
      sysd_obs_json="$workdir/systemd-obs-synth.json"
      systemd_synthesize_observed "$sysd_old_json" "$sysd_obs_json"
    fi
    DOM_NEW_SYSTEMD_JSON="$sysd_new_json"

    DOM_SYSTEMD_PLAN="$workdir/systemd-plan.json"
    "$bindir/ubx-systemd" plan --old-manifest "$sysd_old_json" --new-manifest "$sysd_new_json" \
      --observed-manifest "$sysd_obs_json" --out "$DOM_SYSTEMD_PLAN" \
      || die "ubx-systemd plan refused (see its stderr above)"
    DOM_SYSTEMD_TOUCH="$(summarize_systemd_plan "$DOM_SYSTEMD_PLAN")"
  else
    DOM_SYSTEMD_PLAN=""
    DOM_SYSTEMD_TOUCH=0
    DOM_NEW_SYSTEMD_JSON=""
  fi

  DOM_USERS_SKIP=0
  if [ -z "$DOM_OLD_USERS_REF" ] && [ -z "$DOM_NEW_USERS_REF" ]; then
    DOM_USERS_SKIP=1
  fi
  if [ "$DOM_USERS_SKIP" = 0 ]; then
    local users_new_json users_passwd users_group users_shadow users_rc
    users_new_json="$(ubx_rebuild_resolve_ref "$DOM_NEW_USERS_REF" "$UBX_REBUILD_EMPTY_USERS_MANIFEST" "$workdir" new-users)" \
      || die "could not resolve the new generation's users manifest"
    users_passwd="${OPT_PASSWD:-/etc/passwd}"
    users_group="${OPT_GROUP:-/etc/group}"
    users_shadow="${OPT_SHADOW:-/etc/shadow}"

    DOM_USERS_PLAN="$workdir/users-plan.json"
    local users_args=("$bindir/ubx-users" plan --manifest "$users_new_json" --passwd "$users_passwd" \
      --group "$users_group" --shadow "$users_shadow" --out "$DOM_USERS_PLAN")
    if [ -n "${OPT_USERS_EXCEPTIONS:-}" ]; then
      users_args+=(--exceptions "$OPT_USERS_EXCEPTIONS")
    fi
    if [ -n "${OPT_HOME_STATE:-}" ]; then
      users_args+=(--home-state "$OPT_HOME_STATE")
    fi
    users_rc=0
    "${users_args[@]}" || users_rc=$?
    if [ "$users_rc" -ne 0 ]; then
      die "ubx-users plan reported hard errors (uid/gid conflicts) — see $DOM_USERS_PLAN"
    fi
    IFS=$'\t' read -r DOM_USERS_TOUCH DOM_USERS_DRIFT DOM_USERS_ERRORS < <(summarize_users_plan "$DOM_USERS_PLAN")
    # Defense in depth: users_rc==0 above should already guarantee
    # plan["errors"] was empty (bin/ubx-users' cmd_plan exits 1 iff it
    # isn't) -- re-checking the count itself rather than trusting the
    # exit code alone mirrors this project's other dual-enforcement
    # checks (e.g. bin/ubx-systemd re-deriving refuseRestart from a
    # unit's own suffix instead of trusting the manifest's flag).
    if [ "$DOM_USERS_ERRORS" != 0 ]; then
      die "ubx-users plan reported errors but exited 0 (should be unreachable) — refusing to proceed"
    fi
  else
    DOM_USERS_PLAN=""
    DOM_USERS_TOUCH=0
    DOM_USERS_DRIFT=0
    DOM_USERS_ERRORS=0
  fi

  # -- snap (GitHub issues #66, #72) --------------------------------------
  #
  # Two independent things use this domain's manifests, both computed
  # here:
  #   - the real plan+apply convergence (issue #72, this block): a plan
  #     computed via `bin/ubx-snap plan` against the OLD declared
  #     manifest, the NEW declared manifest, and an observed-state
  #     manifest -- exactly etc/systemd's own plan_domains shape above.
  #   - bin/ubx-snap-purge's OWN separate undeclared-snap sweep (issue
  #     #66, execute_domains below): that tool does its OWN observation (a
  #     live `snap list`) and diffs it against the declared manifest
  #     directly, so it only ever needs DOM_NEW_SNAP_JSON -- which this
  #     block keeps resolving exactly as before, unconditionally, so the
  #     purge sweep's own wiring (tests/unit/149) is untouched by this
  #     addition.
  # Skipped (like every other domain) only when NEITHER the old nor the
  # new generation declares anything for this domain.
  DOM_SNAP_SKIP=0
  if [ -z "$DOM_OLD_SNAP_REF" ] && [ -z "$DOM_NEW_SNAP_REF" ]; then
    DOM_SNAP_SKIP=1
  fi
  if [ "$DOM_SNAP_SKIP" = 0 ]; then
    local snap_old_json snap_obs_json
    snap_old_json="$(ubx_rebuild_resolve_ref "$DOM_OLD_SNAP_REF" "$UBX_REBUILD_EMPTY_SNAP_MANIFEST" "$workdir" old-snap)" \
      || die "could not resolve the old generation's snap manifest"
    DOM_NEW_SNAP_JSON="$(ubx_rebuild_resolve_ref "$DOM_NEW_SNAP_REF" "$UBX_REBUILD_EMPTY_SNAP_MANIFEST" "$workdir" new-snap)" \
      || die "could not resolve the new generation's snap manifest"
    if [ -n "${OPT_SNAP_OBSERVED:-}" ]; then
      snap_obs_json="$OPT_SNAP_OBSERVED"
    else
      snap_obs_json="$workdir/snap-obs-synth.json"
      snap_synthesize_observed "$snap_old_json" "$snap_obs_json"
    fi

    DOM_SNAP_PLAN="$workdir/snap-plan.json"
    "$bindir/ubx-snap" plan --old-manifest "$snap_old_json" --new-manifest "$DOM_NEW_SNAP_JSON" \
      --observed-manifest "$snap_obs_json" --out "$DOM_SNAP_PLAN" \
      || die "ubx-snap plan refused (see its stderr above)"
    DOM_SNAP_TOUCH="$(summarize_snap_plan "$DOM_SNAP_PLAN")"
  else
    DOM_SNAP_PLAN=""
    DOM_SNAP_TOUCH=0
    DOM_NEW_SNAP_JSON=""
  fi
}

# report_domains VERBOSE — prints the deterministic touched-domains report
# (SPEC.md §7) from the DOM_* globals plan_domains just set. VERBOSE=1
# (used by `ubx diff`) prints each domain's full plan content; VERBOSE=0
# (used by `rebuild`/`rollback`) prints one summary line per domain.
report_domains() {
  local verbose="$1"

  if [ "$DOM_ETC_SKIP" = 1 ]; then
    echo "etc: nothing declared (no old or new /etc manifest)"
  elif [ "$verbose" = 1 ]; then
    if [ -s "$DOM_ETC_PLAN" ]; then
      echo "etc:"
      # awk (not sed) so a plan file missing a final trailing newline (a
      # possibility any time a command substitution captured it — command
      # substitution always strips trailing newlines) still ends its last
      # printed line cleanly instead of running into whatever prints next.
      awk '{ print "  " $0 }' "$DOM_ETC_PLAN"
    else
      echo "etc: nothing to do (fully converged)"
    fi
  else
    echo "etc: $DOM_ETC_TOUCH action(s) touched ($DOM_ETC_DRIFT drift)"
  fi

  if [ "$DOM_SYSTEMD_SKIP" = 1 ]; then
    echo "systemd: nothing declared (no old or new systemd manifest)"
  elif [ "$verbose" = 1 ]; then
    "$bindir/ubx-systemd" report --plan "$DOM_SYSTEMD_PLAN"
  else
    echo "systemd: $DOM_SYSTEMD_TOUCH action(s) touched"
  fi

  if [ "$DOM_USERS_SKIP" = 1 ]; then
    echo "users: nothing declared (no old or new users manifest)"
  elif [ "$verbose" = 1 ]; then
    users_plan_report "$DOM_USERS_PLAN"
  else
    echo "users: $DOM_USERS_TOUCH action(s) touched ($DOM_USERS_DRIFT drift)"
  fi

  # snap is reported LAST, after etc/systemd/users, keeping this file's
  # documented FIXED domain order (see this section's own header comment,
  # above) and the same append-at-the-end position the snap-purge sweep
  # already established in execute_domains for issue #66.
  if [ "$DOM_SNAP_SKIP" = 1 ]; then
    echo "snap: nothing declared (no old or new snap manifest)"
  elif [ "$verbose" = 1 ]; then
    "$bindir/ubx-snap" report --plan "$DOM_SNAP_PLAN"
  else
    echo "snap: $DOM_SNAP_TOUCH action(s) touched"
  fi
}

# execute_domains — attempts real activation for the domains that have a
# real executor (see this file's header). Only ever called for
# switch/test, never boot, and never in --dry-run mode.
#
# VERB (the snap domain only -- both its plan+apply convergence, GitHub
# issue #72, and its purge sweep, issue #66; "" from bin/ubx's own
# cmd_rollback, which deliberately never triggers either; see the snap
# block below) gates both bin/ubx-snap-apply's real invocation and
# bin/ubx-snap-purge's dry-run/apply mode: `switch` honors the caller's own
# --apply/--dry-run exactly like etc/systemd above; `test` NEVER really
# applies either one, even when APPLY=1 -- both are potentially
# irreversible live snapd mutations (installing/reverting a snap
# revision; purging a payload) and `ubx rebuild test` is meant to be
# safely re-tried/rolled back from (a plain reboot already returns to the
# last-good generation, SPEC.md §4.3) without first mutating anything on
# the live system.
execute_domains() {
  local systemd_unit_dir="$1" systemd_content_dir="$2" apply="$3" users_out="$4" etc_content_dir="$5" etc_dir="$6" verb="${7:-}"

  if [ "$DOM_ETC_SKIP" = 0 ]; then
    local content_dir="$etc_content_dir"
    if [ -z "$content_dir" ]; then
      content_dir="$(dirname "$DOM_NEW_ETC_JSON")"
    fi
    local etc_apply_args=("$bindir/ubx-etc-apply" --plan "$DOM_ETC_PLAN" --content-dir "$content_dir" --etc-dir "$etc_dir")
    if [ "$apply" = 1 ]; then
      etc_apply_args+=(--apply)
    else
      etc_apply_args+=(--dry-run)
    fi
    "${etc_apply_args[@]}"
  fi

  if [ "$DOM_SYSTEMD_SKIP" = 0 ]; then
    local content_dir="$systemd_content_dir"
    if [ -z "$content_dir" ]; then
      content_dir="$(dirname "$DOM_NEW_SYSTEMD_JSON")"
    fi
    local apply_args=("$bindir/ubx-systemd-apply" --plan "$DOM_SYSTEMD_PLAN" --unit-dir "$systemd_unit_dir" --content-dir "$content_dir")
    if [ "$apply" = 1 ]; then
      apply_args+=(--apply)
    else
      apply_args+=(--dry-run)
    fi
    "${apply_args[@]}"
  fi

  if [ "$DOM_USERS_SKIP" = 0 ]; then
    local script="$users_out"
    "$bindir/ubx-users" execute --plan "$DOM_USERS_PLAN" --format shell --out "$script"
    echo "users: activation script written to $script (not executed — ubx-users execute only ever emits it; run it as root to converge, or see docs/users.md)"
  fi

  if [ "$DOM_SNAP_SKIP" = 0 ] && { [ "$verb" = switch ] || [ "$verb" = test ]; }; then
    # -- snap plan+apply convergence (GitHub issue #72) --------------------
    #
    # Runs BEFORE the purge sweep just below: converge the DECLARED snaps
    # first (install/refresh/revert/connect/config/hold), then sweep away
    # whatever is left undeclared -- the same "converge what's wanted
    # before removing what isn't" order etc/systemd/users already imply by
    # running ahead of this whole snap block.
    #
    # Unlike bin/ubx-etc-apply/bin/ubx-systemd-apply, bin/ubx-snap-apply
    # has no --apply/--dry-run flag of its own (see its own header/usage):
    # every invocation mutates for real through the injectable UBX_SNAP_CMD
    # seam. So the dry-run/apply gate lives entirely HERE, at the call
    # site: dry-run means simply never invoking it at all (report_domains,
    # called earlier in bin/ubx's do_rebuild/cmd_rollback, has already
    # printed this plan, so nothing is lost by skipping the call).
    #
    # Safety posture mirrors the snap-purge sweep immediately below
    # (per this issue's acceptance criteria, "honor the same safety
    # posture the existing snap-purge block uses"): `switch --apply` is
    # the only combination that ever calls ubx-snap-apply for real;
    # `test` NEVER does, even when APPLY=1 -- ack/install/refresh/revert
    # actions can be just as destructive/irreversible (installing a new
    # snap revision, reverting one) as the purge sweep's own removals, and
    # `ubx rebuild test` is meant to be safely re-tried/rolled back from
    # (a plain reboot already returns to the last-good generation) without
    # first mutating live snapd state.
    if [ "$apply" = 1 ] && [ "$verb" = switch ]; then
      # --payload-dir/--assert-dir SHOULD resolve to wherever the new
      # generation's snap-domain manifest build actually placed the
      # vendored .snap payloads and .snap-declaration assertions --
      # bin/ubx-generations' reserved GEN_SNAP_MANIFEST field is exactly
      # that location (see bin/ubx-snap-apply's own header, "Payload/
      # assertion resolution", and docs/snap.md's "tracked gap"). That
      # field is resolved to a manifest.json path above
      # (ubx_rebuild_resolve_ref), but no on-device Nix composition wires
      # a REAL directory tree of payloads/assertions alongside it yet
      # (this file's own header, "on-device Nix evaluation/composition
      # does not exist yet"). Rather than inventing new generation
      # machinery to bridge that gap, this derives both directories from
      # DOM_NEW_SNAP_JSON's own location -- exactly the same "alongside
      # the resolved manifest" convention DOM_NEW_ETC_JSON/
      # DOM_NEW_SYSTEMD_JSON's own content-dir defaults already use above
      # -- and documents the assumption loudly here, as this project's own
      # posture demands, rather than gloss over it.
      local snap_dir
      snap_dir="$(dirname "$DOM_NEW_SNAP_JSON")"
      "$bindir/ubx-snap-apply" --plan "$DOM_SNAP_PLAN" --payload-dir "$snap_dir" --assert-dir "$snap_dir"
    else
      echo "snap: dry-run only -- ubx-snap-apply not invoked (pass --apply under 'rebuild switch' to converge snapd for real; 'ubx rebuild test' never mutates snapd, mirroring the snap-purge sweep's own safety posture below)"
    fi

    local snap_purge_args=("$bindir/ubx-snap-purge" --manifest "$DOM_NEW_SNAP_JSON")
    if [ "$apply" = 1 ] && [ "$verb" = switch ]; then
      snap_purge_args+=(--apply)
    else
      snap_purge_args+=(--dry-run)
    fi
    "${snap_purge_args[@]}"
  fi
}

# =====================================================================
# rebuild
# =====================================================================

cmd_rebuild_usage() {
  cat <<USAGE
usage: ubx rebuild <switch|boot|test> [options]

Registers a new generation (via bin/ubx-generations) and, per verb:
  switch   activate all live domains now, AND set the GRUB default
  boot     set the GRUB default only — no live activation
  test     activate all live domains now, but NEVER touch the GRUB
           default (a plain reboot returns to the last-good generation)

Generation-creation options (passed through to 'ubx-generations create';
required unless --dry-run):
  --rootfs-image PATH --kernel PATH --initrd PATH --root-device DEV
  --kernel-params PARAMS --title TITLE
  --snap-manifest PATH   also doubles as this generation's declared snap
                         manifest (nix/snap.nix's per-generation manifest,
                         issue #60): 'switch'/'test' feed it straight to
                         'ubx-snap-purge' as the reconcile-time undeclared-
                         snap purge sweep (GitHub issue #66) -- 'test'
                         always runs it dry-run, regardless of --apply.
                         Omitted entirely means "nothing declared for this
                         domain", same as every other domain below.

Domain declaration options (all optional — an omitted one means "this
generation declares nothing new for that domain"):
  --etc-ref PATH          new generation's /etc manifest (file, or a
                          directory containing manifest.json)
  --systemd-ref PATH      new generation's systemd manifest (same shape)
  --users-manifest PATH   new generation's users/groups manifest (JSON file)

Observed-state overrides (default: assume the OLD generation's own
manifest already matches reality — i.e. no drift; override to plan
against a real, observed system instead):
  --etc-observed FILE --etc-exceptions FILE
  --systemd-observed FILE
  --snap-observed FILE    (default: synthesized from the OLD generation's
                          own declared snap manifest, assuming it is
                          already fully converged -- see
                          snap_synthesize_observed's own comment in this
                          file for why this is a straight copy rather than
                          a real 'ubx-snap observe' call)
  --passwd FILE --group FILE --shadow FILE (default /etc/{passwd,group,shadow})
  --users-exceptions FILE --home-state FILE

Execution options:
  --root DIR              generations root (default \$UBX_GEN_ROOT, else
                           /ubx/var/generations)
  --dry-run                compute and print the touched-domains report
                           only; registers NO generation, writes NO GRUB
                           default, executes nothing (needs no root)
  --apply                  attempt real activation where an executor
                           exists (bin/ubx-etc-apply, bin/ubx-systemd-apply,
                           bin/ubx-snap-apply; the systemd one requires
                           systemctl on PATH — see its own --help). 'test'
                           never really applies bin/ubx-snap-apply/
                           ubx-snap-purge even when given (see
                           execute_domains' own header). Default without
                           --apply: dry-run print.
  --systemd-unit-dir DIR   (default /etc/systemd/system)
  --systemd-content-dir DIR (default: alongside the new systemd manifest)
  --etc-dir DIR             the real (or, for tests, temp) /etc root
                            bin/ubx-etc-apply targets (default /etc)
  --etc-content-dir DIR     (default: alongside the new etc manifest)
  --users-out FILE          where to write the generated users activation
                            shell script (default: a temp file, printed)

See SPEC.md §4.3, §4.5 for the full verb semantics.
USAGE
}

do_rebuild() {
  local verb="$1"
  shift

  local root="" title="" rootfs_image="" kernel="" initrd="" root_device="" kernel_params="" snap_manifest=""
  local etc_ref="" systemd_ref="" users_manifest=""
  local systemd_unit_dir="/etc/systemd/system" systemd_content_dir="" users_out=""
  local etc_dir="/etc" etc_content_dir=""
  local apply=0 dry_run=0
  OPT_ETC_OBSERVED="" OPT_ETC_EXCEPTIONS="" OPT_SYSTEMD_OBSERVED="" OPT_SNAP_OBSERVED=""
  OPT_PASSWD="" OPT_GROUP="" OPT_SHADOW="" OPT_USERS_EXCEPTIONS="" OPT_HOME_STATE=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || die "--root requires an argument"; root="$2"; shift 2 ;;
      --title) [ $# -ge 2 ] || die "--title requires an argument"; title="$2"; shift 2 ;;
      --rootfs-image) [ $# -ge 2 ] || die "--rootfs-image requires an argument"; rootfs_image="$2"; shift 2 ;;
      --kernel) [ $# -ge 2 ] || die "--kernel requires an argument"; kernel="$2"; shift 2 ;;
      --initrd) [ $# -ge 2 ] || die "--initrd requires an argument"; initrd="$2"; shift 2 ;;
      --root-device) [ $# -ge 2 ] || die "--root-device requires an argument"; root_device="$2"; shift 2 ;;
      --kernel-params) [ $# -ge 2 ] || die "--kernel-params requires an argument"; kernel_params="$2"; shift 2 ;;
      --snap-manifest) [ $# -ge 2 ] || die "--snap-manifest requires an argument"; snap_manifest="$2"; shift 2 ;;
      --etc-ref) [ $# -ge 2 ] || die "--etc-ref requires an argument"; etc_ref="$2"; shift 2 ;;
      --systemd-ref) [ $# -ge 2 ] || die "--systemd-ref requires an argument"; systemd_ref="$2"; shift 2 ;;
      --users-manifest) [ $# -ge 2 ] || die "--users-manifest requires an argument"; users_manifest="$2"; shift 2 ;;
      --etc-observed) [ $# -ge 2 ] || die "--etc-observed requires an argument"; OPT_ETC_OBSERVED="$2"; shift 2 ;;
      --etc-exceptions) [ $# -ge 2 ] || die "--etc-exceptions requires an argument"; OPT_ETC_EXCEPTIONS="$2"; shift 2 ;;
      --systemd-observed) [ $# -ge 2 ] || die "--systemd-observed requires an argument"; OPT_SYSTEMD_OBSERVED="$2"; shift 2 ;;
      --snap-observed) [ $# -ge 2 ] || die "--snap-observed requires an argument"; OPT_SNAP_OBSERVED="$2"; shift 2 ;;
      --passwd) [ $# -ge 2 ] || die "--passwd requires an argument"; OPT_PASSWD="$2"; shift 2 ;;
      --group) [ $# -ge 2 ] || die "--group requires an argument"; OPT_GROUP="$2"; shift 2 ;;
      --shadow) [ $# -ge 2 ] || die "--shadow requires an argument"; OPT_SHADOW="$2"; shift 2 ;;
      --users-exceptions) [ $# -ge 2 ] || die "--users-exceptions requires an argument"; OPT_USERS_EXCEPTIONS="$2"; shift 2 ;;
      --home-state) [ $# -ge 2 ] || die "--home-state requires an argument"; OPT_HOME_STATE="$2"; shift 2 ;;
      --systemd-unit-dir) [ $# -ge 2 ] || die "--systemd-unit-dir requires an argument"; systemd_unit_dir="$2"; shift 2 ;;
      --systemd-content-dir) [ $# -ge 2 ] || die "--systemd-content-dir requires an argument"; systemd_content_dir="$2"; shift 2 ;;
      --etc-dir) [ $# -ge 2 ] || die "--etc-dir requires an argument"; etc_dir="$2"; shift 2 ;;
      --etc-content-dir) [ $# -ge 2 ] || die "--etc-content-dir requires an argument"; etc_content_dir="$2"; shift 2 ;;
      --users-out) [ $# -ge 2 ] || die "--users-out requires an argument"; users_out="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h | --help) cmd_rebuild_usage; exit 0 ;;
      *) echo "ubx: rebuild $verb: unknown option: $1" >&2; cmd_rebuild_usage >&2; exit 2 ;;
    esac
  done

  [ -n "$root" ] || root="$(ubx_rebuild_default_root)"

  if [ "$dry_run" = 0 ]; then
    [ -n "$rootfs_image" ] || die "rebuild $verb: --rootfs-image is required (or pass --dry-run)"
    [ -n "$kernel" ] || die "rebuild $verb: --kernel is required (or pass --dry-run)"
    [ -n "$initrd" ] || die "rebuild $verb: --initrd is required (or pass --dry-run)"
    [ -n "$root_device" ] || die "rebuild $verb: --root-device is required (or pass --dry-run)"
  fi

  local workdir
  workdir="$(mktemp -d)"
  # shellcheck disable=SC2064  # intentional: expand $workdir NOW (it is
  # `local` to this function and would be unset by the time an EXIT trap
  # set with single quotes fired after the function returned)
  trap "rm -rf -- '$workdir'" EXIT

  local old_current
  old_current="$(ubx_rebuild_effective_booted "$root")"
  IFS=$'\t' read -r DOM_OLD_ETC_REF DOM_OLD_SYSTEMD_REF DOM_OLD_USERS_REF DOM_OLD_SNAP_REF \
    < <(ubx_rebuild_domain_refs "$root" "$old_current")
  DOM_NEW_ETC_REF="$etc_ref"
  DOM_NEW_SYSTEMD_REF="$systemd_ref"
  DOM_NEW_USERS_REF="$users_manifest"
  DOM_NEW_SNAP_REF="$snap_manifest"

  local new_idx=""
  if [ "$dry_run" = 0 ]; then
    local create_args=(create --root "$root" --rootfs-image "$rootfs_image" --kernel "$kernel" \
      --initrd "$initrd" --root-device "$root_device")
    [ -z "$title" ] || create_args+=(--title "$title")
    [ -z "$kernel_params" ] || create_args+=(--kernel-params "$kernel_params")
    [ -z "$etc_ref" ] || create_args+=(--etc-ref "$etc_ref")
    [ -z "$users_manifest" ] || create_args+=(--users-manifest "$users_manifest")
    [ -z "$snap_manifest" ] || create_args+=(--snap-manifest "$snap_manifest")
    new_idx="$("$bindir/ubx-generations" "${create_args[@]}")" \
      || die "rebuild $verb: failed to register the new generation"
    ubx_rebuild_write_sidecar "$root" "$new_idx" "$systemd_ref" \
      || die "rebuild $verb: failed to record the systemd manifest reference for generation $new_idx"
  fi

  plan_domains "$workdir"

  if [ "$dry_run" = 1 ]; then
    local pending
    pending="$(peek_next_index "$root")"
    echo "ubx rebuild $verb (dry-run): would register generation $pending (from generation ${old_current:-<none>})"
  else
    echo "ubx rebuild $verb: generation $new_idx (from generation ${old_current:-<none>})"
  fi
  echo "domains:"
  report_domains 0 | sed 's/^/  /'

  if [ "$verb" = switch ] || [ "$verb" = test ]; then
    if [ "$dry_run" = 0 ]; then
      local exec_users_out="$users_out"
      [ -n "$exec_users_out" ] || exec_users_out="$root/$new_idx/users-activate.sh"
      execute_domains "$systemd_unit_dir" "$systemd_content_dir" "$apply" "$exec_users_out" "$etc_content_dir" "$etc_dir" "$verb"
      ubx_rebuild_write_booted "$root" "$new_idx"

      # -- Soft-reboot activation (issue #30) -----------------------------
      #
      # Classified AFTER ubx_rebuild_write_booted so the booted marker is
      # never left stale under a changed image/kernel, but against
      # old_current -- captured at the TOP of this function, before that
      # write -- so the comparison is genuinely old-vs-new, never new-vs-
      # new. `test` classifies purely for an informational line: a plain
      # reboot already returns to the last-good generation (the GRUB-
      # default matrix below never moves for `test`), so it must never
      # itself trigger any reboot, soft or full.
      local delta_class
      delta_class="$(ubx_rebuild_classify_delta "$root" "$old_current" "$new_idx")"
      case "$delta_class" in
        image)
          if [ "$verb" = switch ]; then
            local nextroot_image
            nextroot_image="$(ubx_rebuild_manifest_get "$root/$new_idx/manifest" GEN_ROOTFS_IMAGE)"
            echo "soft-reboot: staging generation $new_idx's rootfs image ($nextroot_image) at $UBX_NEXTROOT_DIR ..."
            "$UBX_NEXTROOT_STAGE_CMD" "$nextroot_image" "$UBX_NEXTROOT_DIR"
            echo "soft-reboot: rootfs image changed, kernel unchanged -- soft-rebooting live into generation $new_idx (a few seconds of downtime, no kernel reboot)"
            "$UBX_SOFT_REBOOT_CMD" soft-reboot
          else
            echo "soft-reboot: rootfs image changed, kernel unchanged -- 'ubx rebuild test' never reboots (a plain reboot already returns to the last-good generation)"
          fi
          ;;
        kernel)
          echo "reboot: the kernel changed (generation $new_idx) -- a FULL REBOOT is required to activate it; ubx will NOT auto-reboot (full reboot is the always-correct fallback, SPEC.md §4.3/§12 R3)"
          ;;
        live-only)
          echo "reboot: not needed -- neither the rootfs image nor the kernel changed"
          ;;
      esac
    else
      local dry_delta_class old_kernel_dr old_image_dr
      old_kernel_dr="$(ubx_rebuild_manifest_get "$root/${old_current}/manifest" GEN_KERNEL_PATH)"
      old_image_dr="$(ubx_rebuild_manifest_get "$root/${old_current}/manifest" GEN_ROOTFS_IMAGE)"
      dry_delta_class="$(_ubx_rebuild_classify_delta_values "$old_kernel_dr" "$old_image_dr" "$kernel" "$rootfs_image")"
      case "$dry_delta_class" in
        image)
          echo "soft-reboot: would soft-reboot into the new rootfs image (kernel unchanged) (dry-run: nothing executed, no reboot attempted)"
          ;;
        kernel)
          echo "reboot: the kernel would change -- a full reboot would be required, ubx would NOT auto-reboot (dry-run: nothing executed)"
          ;;
        live-only)
          echo "reboot: would not be needed -- neither the rootfs image nor the kernel would change (dry-run: nothing executed)"
          ;;
      esac
      echo "(dry-run: no execution attempted)"
    fi
  fi

  # -- The GRUB-default matrix: switch/boot set it, test NEVER does. -------
  case "$verb" in
    switch | boot)
      if [ "$dry_run" = 1 ]; then
        local pending2
        pending2="$(peek_next_index "$root")"
        echo "grub default: would be set to generation $pending2 (dry-run — nothing written)"
      else
        ubx_rebuild_write_grub_default "$root" "$new_idx"
        echo "grub default: set to generation $new_idx"
      fi
      ;;
    test)
      echo "grub default: unchanged — 'ubx rebuild test' never touches it (a plain reboot returns to the last-good generation)"
      ;;
  esac
}

cmd_rebuild() {
  local verb="${1:-}"
  case "$verb" in
    switch | boot | test)
      shift
      do_rebuild "$verb" "$@"
      ;;
    -h | --help)
      cmd_rebuild_usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

# =====================================================================
# rollback
# =====================================================================

cmd_rollback_usage() {
  cat <<USAGE
usage: ubx rollback [N] [options]

Re-converges the live domains (etc, systemd, users) to generation N's
retained manifests (default: the on-disk "previous" generation) and moves
the GRUB default back to it. N is resolved via
'ubx-generations rollback-target', so a generation that exists on disk but
is no longer retained under the given/default retention policy is refused
(its store artifacts may already be gone).

  --root DIR             generations root (default \$UBX_GEN_ROOT, else
                         /ubx/var/generations)
  --retain COUNT|all     retention policy rollback-target validates N
                         against (default: 5, mirrors that tool's own default)
  --dry-run              report only; touches no GRUB default, executes
                         nothing (needs no root)
  --apply                attempt real activation where an executor exists
                         (see 'ubx rebuild --help')
  --etc-observed FILE --etc-exceptions FILE
  --systemd-observed FILE
  --snap-observed FILE    (default: synthesized from the booted generation's
                          own declared snap manifest — see 'ubx rebuild
                          --help')
  --passwd FILE --group FILE --shadow FILE (default /etc/{passwd,group,shadow})
  --users-exceptions FILE --home-state FILE
  --systemd-unit-dir DIR --systemd-content-dir DIR --users-out FILE
  --etc-dir DIR --etc-content-dir DIR
USAGE
}

cmd_rollback() {
  local root="" retain=5 apply=0 dry_run=0 target_arg=""
  local systemd_unit_dir="/etc/systemd/system" systemd_content_dir="" users_out=""
  local etc_dir="/etc" etc_content_dir=""
  OPT_ETC_OBSERVED="" OPT_ETC_EXCEPTIONS="" OPT_SYSTEMD_OBSERVED="" OPT_SNAP_OBSERVED=""
  OPT_PASSWD="" OPT_GROUP="" OPT_SHADOW="" OPT_USERS_EXCEPTIONS="" OPT_HOME_STATE=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || die "--root requires an argument"; root="$2"; shift 2 ;;
      --retain) [ $# -ge 2 ] || die "--retain requires an argument"; retain="$2"; shift 2 ;;
      --etc-observed) [ $# -ge 2 ] || die "--etc-observed requires an argument"; OPT_ETC_OBSERVED="$2"; shift 2 ;;
      --etc-exceptions) [ $# -ge 2 ] || die "--etc-exceptions requires an argument"; OPT_ETC_EXCEPTIONS="$2"; shift 2 ;;
      --systemd-observed) [ $# -ge 2 ] || die "--systemd-observed requires an argument"; OPT_SYSTEMD_OBSERVED="$2"; shift 2 ;;
      --snap-observed) [ $# -ge 2 ] || die "--snap-observed requires an argument"; OPT_SNAP_OBSERVED="$2"; shift 2 ;;
      --passwd) [ $# -ge 2 ] || die "--passwd requires an argument"; OPT_PASSWD="$2"; shift 2 ;;
      --group) [ $# -ge 2 ] || die "--group requires an argument"; OPT_GROUP="$2"; shift 2 ;;
      --shadow) [ $# -ge 2 ] || die "--shadow requires an argument"; OPT_SHADOW="$2"; shift 2 ;;
      --users-exceptions) [ $# -ge 2 ] || die "--users-exceptions requires an argument"; OPT_USERS_EXCEPTIONS="$2"; shift 2 ;;
      --home-state) [ $# -ge 2 ] || die "--home-state requires an argument"; OPT_HOME_STATE="$2"; shift 2 ;;
      --systemd-unit-dir) [ $# -ge 2 ] || die "--systemd-unit-dir requires an argument"; systemd_unit_dir="$2"; shift 2 ;;
      --systemd-content-dir) [ $# -ge 2 ] || die "--systemd-content-dir requires an argument"; systemd_content_dir="$2"; shift 2 ;;
      --etc-dir) [ $# -ge 2 ] || die "--etc-dir requires an argument"; etc_dir="$2"; shift 2 ;;
      --etc-content-dir) [ $# -ge 2 ] || die "--etc-content-dir requires an argument"; etc_content_dir="$2"; shift 2 ;;
      --users-out) [ $# -ge 2 ] || die "--users-out requires an argument"; users_out="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h | --help) cmd_rollback_usage; exit 0 ;;
      -*)
        echo "ubx: rollback: unknown option: $1" >&2
        cmd_rollback_usage >&2
        exit 2
        ;;
      *)
        if [ -z "$target_arg" ]; then
          target_arg="$1"
          shift
        else
          echo "ubx: rollback: unexpected argument: $1" >&2
          cmd_rollback_usage >&2
          exit 2
        fi
        ;;
    esac
  done

  [ -n "$root" ] || root="$(ubx_rebuild_default_root)"
  [ -n "$target_arg" ] || target_arg="previous"

  local current previous booted_gen
  current="$(ubx_rebuild_read_pointer "$root" current)"
  previous="$(ubx_rebuild_read_pointer "$root" previous)"
  [ -n "$current" ] || die "rollback: no current generation recorded at $root/current — nothing to roll back from"
  # The generation to re-converge FROM is whatever this orchestrator last
  # actually booted/converged live (see bin/ubx-rebuild-lib's header, "the
  # 'booted' marker") -- NOT necessarily bin/ubx-generations' own "current"
  # pointer, which only tracks the last REGISTERED generation and can be
  # stale relative to a previous rollback or a boot-only registration.
  booted_gen="$(ubx_rebuild_effective_booted "$root")"

  local rt_args=(rollback-target "$target_arg" --root "$root" --retain "$retain" --booted "$booted_gen")
  [ -z "$previous" ] || rt_args+=(--previous "$previous")
  local target
  target="$("$bindir/ubx-generations" "${rt_args[@]}")" || die "rollback: could not resolve target '$target_arg'"

  local workdir
  workdir="$(mktemp -d)"
  # shellcheck disable=SC2064  # intentional: expand $workdir NOW (it is
  # `local` to this function and would be unset by the time an EXIT trap
  # set with single quotes fired after the function returned)
  trap "rm -rf -- '$workdir'" EXIT

  IFS=$'\t' read -r DOM_OLD_ETC_REF DOM_OLD_SYSTEMD_REF DOM_OLD_USERS_REF DOM_OLD_SNAP_REF \
    < <(ubx_rebuild_domain_refs "$root" "$booted_gen")
  IFS=$'\t' read -r DOM_NEW_ETC_REF DOM_NEW_SYSTEMD_REF DOM_NEW_USERS_REF DOM_NEW_SNAP_REF \
    < <(ubx_rebuild_domain_refs "$root" "$target")

  plan_domains "$workdir"

  echo "ubx rollback: generation $booted_gen -> $target"
  echo "domains:"
  report_domains 0 | sed 's/^/  /'

  if [ "$dry_run" = 0 ]; then
    local exec_users_out="$users_out"
    [ -n "$exec_users_out" ] || exec_users_out="$root/$target/rollback-users-activate.sh"
    # VERB is deliberately omitted (empty) here -- see execute_domains'
    # own header: `ubx rollback` never triggers the snap-purge sweep
    # (GitHub issue #66 scoped this to `ubx rebuild switch|test` only), even
    # though a target generation may itself declare a snap manifest.
    execute_domains "$systemd_unit_dir" "$systemd_content_dir" "$apply" "$exec_users_out" "$etc_content_dir" "$etc_dir" ""
    ubx_rebuild_write_booted "$root" "$target"
    ubx_rebuild_write_grub_default "$root" "$target"
    echo "grub default: set to generation $target"
  else
    echo "grub default: would be set to generation $target (dry-run — nothing written)"
  fi
}

# =====================================================================
# list-generations
# =====================================================================

cmd_list_generations_usage() {
  cat <<USAGE
usage: ubx list-generations [--root DIR] [--porcelain]

Wraps 'ubx-generations list' — see 'ubx-generations list --help'.
USAGE
}

cmd_list_generations() {
  local root="" porcelain=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || die "--root requires an argument"; root="$2"; shift 2 ;;
      --porcelain) porcelain=1; shift ;;
      -h | --help) cmd_list_generations_usage; exit 0 ;;
      *) echo "ubx: list-generations: unknown option: $1" >&2; cmd_list_generations_usage >&2; exit 2 ;;
    esac
  done
  [ -n "$root" ] || root="$(ubx_rebuild_default_root)"

  local args=(list --root "$root")
  [ "$porcelain" = 0 ] || args+=(--porcelain)
  "$bindir/ubx-generations" "${args[@]}"
}

# =====================================================================
# diff
# =====================================================================

cmd_diff_usage() {
  cat <<USAGE
usage: ubx diff [A] [B] [--root DIR] [options]

Shows the domain-level delta between two generations' manifests (etc,
systemd, users — see 'ubx rebuild --help' for the shared domain-plan
concepts). Observed state defaults to A's own manifest (i.e. "assume A is
exactly converged, show what moving to B would change"); pass the
--*-observed/--passwd/--group/--shadow overrides for a real, live-drift-
aware diff instead.

  (no args)    diff previous -> current
  A            diff current -> A
  A B          diff A -> B

  --root DIR
  --etc-observed FILE --etc-exceptions FILE
  --systemd-observed FILE
  --snap-observed FILE
  --passwd FILE --group FILE --shadow FILE
  --users-exceptions FILE --home-state FILE
USAGE
}

cmd_diff() {
  local root=""
  OPT_ETC_OBSERVED="" OPT_ETC_EXCEPTIONS="" OPT_SYSTEMD_OBSERVED="" OPT_SNAP_OBSERVED=""
  OPT_PASSWD="" OPT_GROUP="" OPT_SHADOW="" OPT_USERS_EXCEPTIONS="" OPT_HOME_STATE=""
  local -a pos=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || die "--root requires an argument"; root="$2"; shift 2 ;;
      --etc-observed) [ $# -ge 2 ] || die "--etc-observed requires an argument"; OPT_ETC_OBSERVED="$2"; shift 2 ;;
      --etc-exceptions) [ $# -ge 2 ] || die "--etc-exceptions requires an argument"; OPT_ETC_EXCEPTIONS="$2"; shift 2 ;;
      --systemd-observed) [ $# -ge 2 ] || die "--systemd-observed requires an argument"; OPT_SYSTEMD_OBSERVED="$2"; shift 2 ;;
      --snap-observed) [ $# -ge 2 ] || die "--snap-observed requires an argument"; OPT_SNAP_OBSERVED="$2"; shift 2 ;;
      --passwd) [ $# -ge 2 ] || die "--passwd requires an argument"; OPT_PASSWD="$2"; shift 2 ;;
      --group) [ $# -ge 2 ] || die "--group requires an argument"; OPT_GROUP="$2"; shift 2 ;;
      --shadow) [ $# -ge 2 ] || die "--shadow requires an argument"; OPT_SHADOW="$2"; shift 2 ;;
      --users-exceptions) [ $# -ge 2 ] || die "--users-exceptions requires an argument"; OPT_USERS_EXCEPTIONS="$2"; shift 2 ;;
      --home-state) [ $# -ge 2 ] || die "--home-state requires an argument"; OPT_HOME_STATE="$2"; shift 2 ;;
      -h | --help) cmd_diff_usage; exit 0 ;;
      -*) echo "ubx: diff: unknown option: $1" >&2; cmd_diff_usage >&2; exit 2 ;;
      *) pos+=("$1"); shift ;;
    esac
  done

  [ -n "$root" ] || root="$(ubx_rebuild_default_root)"

  local a="" b=""
  case "${#pos[@]}" in
    0)
      b="$(ubx_rebuild_read_pointer "$root" current)"
      [ -n "$b" ] || die "diff: no current generation recorded at $root/current"
      a="$(ubx_rebuild_read_pointer "$root" previous)"
      ;;
    1)
      a="$(ubx_rebuild_effective_booted "$root")"
      [ -n "$a" ] || die "diff: no current/booted generation recorded at $root (needed as the baseline for a single-argument diff)"
      b="${pos[0]}"
      ;;
    2)
      a="${pos[0]}"
      b="${pos[1]}"
      ;;
    *)
      cmd_diff_usage >&2
      exit 2
      ;;
  esac

  local workdir
  workdir="$(mktemp -d)"
  # shellcheck disable=SC2064  # intentional: expand $workdir NOW (it is
  # `local` to this function and would be unset by the time an EXIT trap
  # set with single quotes fired after the function returned)
  trap "rm -rf -- '$workdir'" EXIT

  IFS=$'\t' read -r DOM_OLD_ETC_REF DOM_OLD_SYSTEMD_REF DOM_OLD_USERS_REF DOM_OLD_SNAP_REF \
    < <(ubx_rebuild_domain_refs "$root" "$a")
  IFS=$'\t' read -r DOM_NEW_ETC_REF DOM_NEW_SYSTEMD_REF DOM_NEW_USERS_REF DOM_NEW_SNAP_REF \
    < <(ubx_rebuild_domain_refs "$root" "$b")

  plan_domains "$workdir"

  echo "ubx diff: generation ${a:-<none>} -> ${b:-<none>}"
  report_domains 1
}

# =====================================================================
# main
# =====================================================================

main() {
  local cmd="${1:-}"

  case "$cmd" in
    -h | --help | help)
      usage
      exit 0
      ;;
    "")
      usage >&2
      exit 2
      ;;
    rebuild)
      shift
      cmd_rebuild "$@"
      ;;
    rollback)
      shift
      cmd_rollback "$@"
      ;;
    list-generations)
      shift
      cmd_list_generations "$@"
      ;;
    diff)
      shift
      cmd_diff "$@"
      ;;
    update)
      not_implemented "$cmd"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
