#!/usr/bin/env bash
# bin/ubx-secrets-key — per-machine + per-user GPG identity ONBOARDING for
# the git-crypt-encrypted secrets/ folder (SPEC.md §8.1 "Keys: per-machine
# GPG identities"; GitHub issue #79, milestone M4 groundwork — installer
# flow integration that CALLS this script automatically at first boot is
# milestone M7 and out of scope here; this script is the mechanism a future
# installer step, or an operator by hand today, invokes).
#
# -- The two subcommands ------------------------------------------------
#
#   ubx-secrets-key machine-init [--gnupg-home DIR] [--uid UID]
#                                [--repo DIR] [--no-collaborator]
#     SPEC.md §8.1: "The installer generates a machine keypair (stored
#     root-only outside the store) and adds it as a git-crypt
#     collaborator." Idempotently (re-running never regenerates or
#     clobbers an existing keypair — see "Idempotence" below) generates a
#     per-machine GPG identity in a root-only GNUPGHOME OUTSIDE the Nix/
#     ubuntnix store, then (unless --repo is omitted or --no-collaborator
#     is given) adds its public key as a git-crypt collaborator in --repo.
#     Prints the machine identity's fingerprint on stdout.
#
#   ubx-secrets-key add-user --pubkey FILE --repo DIR [--gnupg-home DIR]
#     SPEC.md §8.1: "the user's personal key is added for editing on
#     workstations." Imports a user-supplied, already-exported armored
#     public key (`gpg --export --armor KEYID > mykey.asc`) and adds it as
#     a git-crypt collaborator in --repo. Never generates or touches a
#     private key belonging to the user — onboarding a personal key is
#     import-and-trust only, exactly the asymmetry SPEC.md §8.1 draws
#     between "the installer generates [the machine key]" and "the user's
#     personal key is added" (added, not generated, here).
#
# -- Why outside the store, and where -------------------------------------
#
# SPEC.md §8.1: "stored root-only outside the store." The store (`/ubx`,
# SPEC.md §4.2) is a read-only, content-addressed, PUBLIC-within-the-machine
# build artifact tree — a private key must never be able to reach it, by
# construction, so this script never writes anywhere under it. Default
# GNUPGHOME is `/var/lib/ubuntnix/secrets-gpg`: `/var` is one of SPEC.md
# §4.2's writable state partitions (sibling to `/home`, `/ubx`, `/flake`),
# and a machine's own GPG identity is exactly the same *kind* of
# machine-local, install-time-created, reboot-persistent secret material
# SPEC.md §4.2's `/etc` "machine-local mutable exceptions" enumerates for
# `machine-id`/SSH host keys/`adjtime` — it just lives under `/var` rather
# than `/etc` because it is GNUPGHOME state (a keyring directory), not a
# single flat file. `--gnupg-home` overrides this for testing (this
# script's own tests never touch a real `/var`).
#
# -- Idempotence -----------------------------------------------------------
#
#   machine-init: before generating anything, looks up whether a secret
#   key already exists in --gnupg-home for the target --uid (default a
#   deterministic `ubuntnix-machine-<hostname> <root@<hostname>>` identity,
#   so a second run against the SAME machine/GNUPGHOME finds the SAME
#   identity string). Found -> generation is skipped entirely (the existing
#   fingerprint is reused for the collaborator-add step below); this is
#   what makes re-running machine-init safe to call on every boot/rebuild
#   without ever clobbering or duplicating the machine's own keypair.
#
#   add-user / the collaborator-add step both of them share: before
#   calling `git-crypt add-gpg-user`, this script checks whether the
#   target fingerprint's OWN encryption-capable subkey ID already appears
#   as a recipient of an existing `.git-crypt/keys/*/0/*.gpg` collaborator
#   file (git-crypt encrypts its internal symmetric key to each
#   collaborator's encryption subkey, not their primary signing key — see
#   `add_collaborator`'s own comment for exactly how that ID is read
#   straight off the collaborator file's own PGP packet header, no
#   decryption or keyring lookup needed). Already present -> the
#   `git-crypt add-gpg-user` call is skipped, so re-running either
#   subcommand against an already-onboarded identity is a real no-op, not
#   a second (differently-enciphered, since GPG encryption is
#   non-deterministic) collaborator file for the same access. NOTE: this
#   is a best-effort, git-crypt-internals-aware dedupe, not a security
#   boundary — calling `git-crypt add-gpg-user` twice for the same key is
#   harmless either way (same resulting access), it would just otherwise
#   show as a spurious modified file on every re-run.
#
# -- Privilege ---------------------------------------------------------
#
# Exactly bin/ubx-etc-apply's own posture: chmod (permission tightening)
# always runs; chown to root:root only runs when this process's own euid
# is 0 (so this script's own tests, run unprivileged, still exercise the
# real chmod path).
set -euo pipefail

prog_name="ubx-secrets-key"
default_gnupg_home="/var/lib/ubuntnix/secrets-gpg"

die() {
  echo "$prog_name: $*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
usage: ubx-secrets-key machine-init [--gnupg-home DIR] [--uid UID] [--repo DIR] [--no-collaborator]
       ubx-secrets-key add-user --pubkey FILE --repo DIR [--gnupg-home DIR]

machine-init:
  --gnupg-home DIR   root-only GPG keyring directory, outside the store
                      (default /var/lib/ubuntnix/secrets-gpg)
  --uid UID           the GPG identity string to generate/look up (default
                      "ubuntnix-machine-<hostname> <root@<hostname>>")
  --repo DIR          also add the (new or existing) machine key as a
                      git-crypt collaborator in this repository
  --no-collaborator   generate/locate the key only; never touch --repo

add-user:
  --pubkey FILE       an already-exported armored GPG public key
                      (`gpg --export --armor KEYID > mykey.asc`)
  --repo DIR          add the imported key as a git-crypt collaborator here
  --gnupg-home DIR    keyring the import lands in (default
                      /var/lib/ubuntnix/secrets-gpg)

Both subcommands are idempotent -- see this script's header, "Idempotence".
USAGE
}

ensure_gpg() {
  command -v gpg >/dev/null 2>&1 || die "gpg is required but not installed"
}

ensure_git_crypt() {
  command -v git-crypt >/dev/null 2>&1 || die "git-crypt is required but not installed"
}

# -- lock a GNUPGHOME dir down: 0700, root:root when we can -----------------
harden_gnupg_home() {
  local dir="$1"
  mkdir -p -- "$dir"
  chmod 700 -- "$dir"
  if [ "$(id -u)" = 0 ]; then
    chown root:root -- "$dir"
  fi
}

# -- re-tighten after gpg has had a chance to create files under it ---------
retighten_gnupg_home() {
  local dir="$1"
  find "$dir" -type d -exec chmod 700 {} + 2>/dev/null || true
  find "$dir" -type f -exec chmod 600 {} + 2>/dev/null || true
}

# -- existing_secret_key_fpr UID: the primary fingerprint of an already-
# present secret key matching UID in the current GNUPGHOME, or empty. -------
existing_secret_key_fpr() {
  local uid="$1"
  # `|| true`: gpg exits non-zero when --list-secret-keys finds nothing for
  # UID (the expected "not yet generated" case, not an error this function
  # should propagate) -- under this script's own `set -e`/`pipefail`, an
  # unguarded pipeline failure here would abort the whole script instead of
  # letting callers see an empty (not-found) result.
  gpg --batch --with-colons --list-secret-keys -- "$uid" 2>/dev/null \
    | awk -F: '$1=="fpr"{print $10; exit}' || true
}

# -- gen_machine_key GNUPGHOME UID: generate a fresh sign+encrypt identity --
#
# `future-default` (ed25519 primary + cv25519 encryption subkey) rather
# than RSA: no large-prime search, so generation is fast and needs far less
# entropy -- both matter for a script that may run at first boot on a
# freshly installed, low-entropy machine. No passphrase: this identity's
# ONLY protection is the root-only 0700/0600 filesystem permissions this
# script itself enforces (harden_gnupg_home/retighten_gnupg_home) -- an
# unattended machine key cannot practically be passphrase-gated (nothing
# would be there to type it in at boot).
gen_machine_key() {
  local gnupg_home="$1" uid="$2"
  export GNUPGHOME="$gnupg_home"
  local out rc
  # `if out=$(...); then rc=0; else rc=$?; fi`, not a bare assignment: a
  # bare `out="$(cmd)"` under this script's own `set -e` would abort the
  # whole script the instant `cmd` fails, before this function ever gets a
  # chance to inspect `$out`/`$rc` and decide whether the gpg-agent-missing
  # fallback below applies -- commands inside an `if` condition are the one
  # place `set -e` never fires, so that is where the capture has to live.
  if out="$(gpg --batch --pinentry-mode loopback --passphrase '' \
    --quick-gen-key -- "$uid" future-default default 0 2>&1)"; then
    rc=0
  else
    rc=$?
  fi
  if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -qiE 'no agent running|failed to start gpg-agent'; then
    # Defensive fallback: some environments (this project's own dev
    # sandbox included) ship a gpg-agent binary that isn't at gpg's own
    # compiled-in default path, so gpg cannot auto-spawn it. A real Ubuntu
    # target machine's archive-packaged gnupg does not hit this branch.
    local agent_bin
    agent_bin="$(command -v gpg-agent || true)"
    if [ -n "$agent_bin" ]; then
      "$agent_bin" --daemon --pinentry-program "$(command -v true)" >/dev/null 2>&1 || true
      if out="$(gpg --batch --pinentry-mode loopback --passphrase '' \
        --quick-gen-key -- "$uid" future-default default 0 2>&1)"; then
        rc=0
      else
        rc=$?
      fi
    fi
  fi
  if [ "$rc" -ne 0 ]; then
    echo "$out" >&2
    die "gpg key generation failed for uid '$uid'"
  fi
  # Best-effort: stop any agent this run may have started, so it never
  # outlives a one-shot invocation (a long-lived onboarding daemon is not
  # this script's job).
  gpgconf --homedir "$gnupg_home" --kill gpg-agent >/dev/null 2>&1 || true
}

# -- encryption_subkey_id GNUPGHOME FPR: the long key ID of FPR's own
# encryption-capable subkey (the ID git-crypt actually encrypts to -- see
# add_collaborator's own comment for why this, not FPR itself, is what a
# collaborator file's packet header names). Empty if not found. ------------
encryption_subkey_id() {
  local gnupg_home="$1" fpr="$2"
  # `|| true`: see existing_secret_key_fpr's own comment -- a lookup miss
  # must not trip `set -e`/`pipefail` here either.
  GNUPGHOME="$gnupg_home" gpg --batch --with-colons --list-keys -- "$fpr" 2>/dev/null \
    | awk -F: '$1=="sub" && $12 ~ /e/ {print $5; exit}' || true
}

# -- collaborator_present REPO KEYID: true iff some existing
# .git-crypt/keys/*/0/*.gpg collaborator file already encrypts to KEYID. ---
#
# git-crypt's own collaborator files are OpenPGP "public-key encrypted
# session key" packets addressed to the recipient's key ID -- that ID is
# part of the packet's own cleartext header (any OpenPGP client needs it to
# know which of its own keys can decrypt the message), so `gpg
# --list-packets` reveals it with NO decryption, keyring lookup, or private
# key access needed at all.
collaborator_present() {
  local repo="$1" keyid="$2" f
  for f in "$repo"/.git-crypt/keys/*/0/*.gpg; do
    [ -e "$f" ] || continue
    if gpg --batch --list-packets -- "$f" 2>/dev/null | grep -qi "keyid $keyid"; then
      return 0
    fi
  done
  return 1
}

# -- add_collaborator REPO FPR GNUPGHOME: idempotently `git-crypt
# add-gpg-user` FPR into REPO, sourcing FPR's public key from GNUPGHOME. ---
add_collaborator() {
  local repo="$1" fpr="$2" gnupg_home="$3"
  ensure_git_crypt
  [ -d "$repo/.git" ] || die "not a git repository (no .git): $repo"

  local sub_keyid
  sub_keyid="$(encryption_subkey_id "$gnupg_home" "$fpr")"

  if [ -n "$sub_keyid" ] && collaborator_present "$repo" "$sub_keyid"; then
    echo "$prog_name: $fpr is already a git-crypt collaborator in $repo -- skipping (idempotent)" >&2
    return 0
  fi

  # --trusted: skip git-crypt's own ownertrust prompt/refusal. Both callers
  # of this function hand it a key WE just generated (ultimately trusted by
  # construction, in our own GNUPGHOME) or a personal key the operator
  # explicitly chose to import via --pubkey -- either way, the trust
  # decision already happened before this call, not inside gpg's ownertrust
  # model.
  ( cd -- "$repo" && GNUPGHOME="$gnupg_home" git-crypt add-gpg-user --trusted -- "$fpr" )
}

cmd_machine_init() {
  local gnupg_home="$default_gnupg_home" uid="" repo="" add_collab=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --gnupg-home) [ $# -ge 2 ] || die "--gnupg-home requires an argument"; gnupg_home="$2"; shift 2 ;;
      --uid) [ $# -ge 2 ] || die "--uid requires an argument"; uid="$2"; shift 2 ;;
      --repo) [ $# -ge 2 ] || die "--repo requires an argument"; repo="$2"; shift 2 ;;
      --no-collaborator) add_collab=0; shift ;;
      -h | --help) usage; exit 0 ;;
      *) echo "$prog_name: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  ensure_gpg

  if [ -z "$uid" ]; then
    local host
    host="$(hostname 2>/dev/null || echo unknown-host)"
    uid="ubuntnix-machine-${host} <root@${host}>"
  fi

  harden_gnupg_home "$gnupg_home"
  export GNUPGHOME="$gnupg_home"

  local fpr
  fpr="$(existing_secret_key_fpr "$uid")"
  if [ -n "$fpr" ]; then
    echo "$prog_name: machine GPG identity already exists for '$uid' ($fpr) -- skipping generation (idempotent)" >&2
  else
    gen_machine_key "$gnupg_home" "$uid"
    fpr="$(existing_secret_key_fpr "$uid")"
    [ -n "$fpr" ] || die "key generation reported success but no matching secret key was found afterward for uid '$uid'"
    echo "$prog_name: generated new machine GPG identity for '$uid' ($fpr)" >&2
  fi

  retighten_gnupg_home "$gnupg_home"

  if [ -n "$repo" ] && [ "$add_collab" -eq 1 ]; then
    add_collaborator "$repo" "$fpr" "$gnupg_home"
  fi

  echo "$fpr"
}

cmd_add_user() {
  local pubkey="" repo="" gnupg_home="$default_gnupg_home"
  while [ $# -gt 0 ]; do
    case "$1" in
      --pubkey) [ $# -ge 2 ] || die "--pubkey requires an argument"; pubkey="$2"; shift 2 ;;
      --repo) [ $# -ge 2 ] || die "--repo requires an argument"; repo="$2"; shift 2 ;;
      --gnupg-home) [ $# -ge 2 ] || die "--gnupg-home requires an argument"; gnupg_home="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      *) echo "$prog_name: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done
  [ -n "$pubkey" ] || die "--pubkey is required"
  [ -f "$pubkey" ] || die "no such file: $pubkey"
  [ -n "$repo" ] || die "--repo is required"

  ensure_gpg
  ensure_git_crypt

  harden_gnupg_home "$gnupg_home"
  export GNUPGHOME="$gnupg_home"

  local fpr
  fpr="$(gpg --batch --with-colons --import-options show-only --import -- "$pubkey" 2>/dev/null \
    | awk -F: '$1=="fpr"{print $10; exit}' || true)"
  [ -n "$fpr" ] || die "could not determine the fingerprint of the key in $pubkey"

  gpg --batch --import -- "$pubkey" >/dev/null 2>&1 || die "failed to import $pubkey into $gnupg_home"
  retighten_gnupg_home "$gnupg_home"

  echo "$prog_name: imported personal key $fpr from $pubkey into $gnupg_home" >&2
  add_collaborator "$repo" "$fpr" "$gnupg_home"

  echo "$fpr"
}

main() {
  [ $# -ge 1 ] || { usage >&2; exit 2; }
  local cmd="$1"
  shift
  case "$cmd" in
    machine-init) cmd_machine_init "$@" ;;
    add-user) cmd_add_user "$@" ;;
    -h | --help) usage; exit 0 ;;
    *) echo "$prog_name: unknown subcommand: $cmd" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
